  userName       String
  recordCount    Int       @default(0)
  fileSizeBytes  Int?
  downloadUrl    String?
  documentId     String?
  expiresAt      DateTime
  errorMessage   String?
  watermark      String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([userId])
  @@index([status])
  @@index([reportId])
  @@index([expiresAt])
}

model ReportScheduleModel {
  id             String    @id @default(uuid())
  reportId       String
  reportTitle    String
  frequency      String    // DAILY, WEEKLY, MONTHLY
  dayOfWeek      Int?
  dayOfMonth     Int?
  timeOfDay      String    @default("08:00")
  format         String    @default("XLSX")
  recipients     String    // JSON stringified recipients array
