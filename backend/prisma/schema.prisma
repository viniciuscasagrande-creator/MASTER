  @@index([creatorUserId])
  @@index([domain])
  @@index([visibility])
  @@index([producerId])
  @@index([eventId])
}

model ReportExportJobModel {
  id             String    @id @default(uuid())
  reportId       String?
  reportTitle    String
  format         String    // XLSX, CSV, PDF
  status         String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, EXPIRED
