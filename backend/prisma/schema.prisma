// ==============================================================================
// DISK INTERNO - PRISMA ORM SCHEMA (PostgreSQL)
// Fase 1.1.5.1: Core Node.js Real - Autenticacao + RBAC + Escopo Produtor/Evento
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}

enum ScopeType {
  GLOBAL
  PRODUCER
  EVENT
}

// ------------------------------------------------------------------------------
// 1. USUÁRIO E IDENTIDADE
// ------------------------------------------------------------------------------

model User {
  id                String               @id @default(uuid())
  name              String
  email             String               @unique
  passwordHash      String
  status            UserStatus           @default(ACTIVE)
  isSuperAdmin      Boolean              @default(false)
  twoFactorEnabled  Boolean              @default(false)
  twoFactorSecret   String?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  // Relações do Core de Identidade
  userRoles         UserRole[]
  userPermissions   UserPermission[]
  producerAccesses  UserProducerAccess[]
  eventAccesses     UserEventAccess[]
  sessions          Session[]
  auditLogs         AuditLog[]
  notifications     NotificationRecipient[]
  preferences       NotificationPreference[]

  @@index([email])
  @@index([status])
}

// ------------------------------------------------------------------------------
// 2. PERFIS (ROLES)
// ------------------------------------------------------------------------------

model Role {
  id              String           @id @default(uuid())
  name            String
  code            String           @unique // Ex: ADMINISTRADOR_GERAL, FINANCEIRO
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([code])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ------------------------------------------------------------------------------
// 3. PERMISSÕES GRANULARES (PERMISSION ENGINE)
// ------------------------------------------------------------------------------

model Permission {
  id              String           @id @default(uuid())
  module          String           // Ex: financeiro, eventos, sac
  resource        String           // Ex: transferencia, saldo, pedido
  action          String           // Ex: visualizar, criar, aprovar
  code            String           @unique // Ex: financeiro.transferencia.aprovar
  description     String?
  createdAt       DateTime         @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([code])
  @@index([module])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  isGranted    Boolean    @default(true) // true = concessão direta, false = revogação explícita
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
}

// ------------------------------------------------------------------------------
// 4. ESCOPO DE DADOS: PRODUTOR & EVENTO
// ------------------------------------------------------------------------------

model Producer {
  id             String               @id @default(uuid())
  name           String
  cnpj           String               @unique
  email          String?
  phone          String?
  status         String               @default("ACTIVE")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  events         Event[]
  userAccesses   UserProducerAccess[]

  @@index([cnpj])
}

model Event {
  id           String            @id @default(uuid())
  producerId   String
  title        String
  venue        String?
  city         String?
  state        String?
  eventDate    DateTime?
  status       String            @default("PUBLISHED")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  producer     Producer          @relation(fields: [producerId], references: [id], onDelete: Restrict)
  userAccesses UserEventAccess[]

  @@index([producerId])
}

model UserProducerAccess {
  id         String   @id @default(uuid())
  userId     String
  producerId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@unique([userId, producerId])
  @@index([userId])
  @@index([producerId])
}

model UserEventAccess {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

// ------------------------------------------------------------------------------
// 5. CONTROLE DE SESSÕES (JWT REFRESH)
// ------------------------------------------------------------------------------

model Session {
  id           String    @id @default(uuid())
  userId       String
  token        String    @unique
  refreshToken String?   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([refreshToken])
}

// ------------------------------------------------------------------------------
// 6. TRILHA DE AUDITORIA IMUTÁVEL
// ------------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userName   String?
  action     String
  resource   String
  producerId String?
  eventId    String?
  details    String?
  ipAddress  String?
  result     String   @default("SUCCESS") // SUCCESS, DENIED, FAILED
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// 7. NOTIFICAÇÕES, OUTBOX & REAL-TIME (FASE 1.1.5.5)
// ------------------------------------------------------------------------------

model Notification {
  id           String    @id @default(uuid())
  type         String    // INFO, SUCCESS, WARNING, CRITICAL, ACTION_REQUIRED
  priority     String    @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  module       String    // FINANCE, EVENTS, SAC, REFUNDS, MARKETING, SECURITY, etc.
  title        String
  description  String
  groupKey     String?   // For anti-noise deduplication & grouping (e.g. sales:evt_1001)
  resourceType String?   // TRANSFER, ORDER, TICKET, INCIDENT, EVENT, etc.
  resourceId   String?
  actionUrl    String?   // e.g. /finance/transfers/trf_123
  producerId   String?
  eventId      String?
  metadata     String?   // JSON stringified extra payload
  createdAt    DateTime  @default(now())

  recipients   NotificationRecipient[]

  @@index([module])
  @@index([groupKey])
  @@index([createdAt])
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId String
  userId         String
  status         String       @default("UNREAD") // UNREAD, READ, ARCHIVED, DISMISSED
  readAt         DateTime?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, status])
}

model NotificationPreference {
  id             String   @id @default(uuid())
  userId         String
  module         String
  channel        String   @default("IN_APP") // IN_APP, EMAIL, WHATSAPP
  isEnabled      Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module, channel])
  @@index([userId])
}

model NotificationRule {
  id              String   @id @default(uuid())
  eventType       String   @unique // e.g. FINANCE_TRANSFER_CREATED
  requiredPerm    String?  // e.g. financeiro.transferencia.aprovar
  defaultPriority String   @default("NORMAL")
  type            String   @default("INFO")
  isMandatory     Boolean  @default(false) // If true, cannot be disabled by user preferences (e.g. security)
  createdAt       DateTime @default(now())
}

model EventOutbox {
  id           String    @id @default(uuid())
  eventId      String    @unique // Unique event ID for idempotency
  eventType    String
  producerId   String?
  eventIdRef   String?
  resourceType String?
  resourceId   String?
  actorUserId  String?
  payload      String    // JSON stringified payload
  status       String    @default("PENDING") // PENDING, PROCESSED, FAILED
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// 8. CENTRAL DE CONSULTA & DOMÍNIOS OPERACIONAIS (FASE 1.1.5.6)
// ------------------------------------------------------------------------------

model Customer {
  id              String          @id @default(uuid())
  name            String
  cpf             String          @unique
  cpfNormalized   String          @unique
  email           String
  emailNormalized String
  phone           String
  phoneNormalized String
  city            String?
  state           String?
  totalOrders     Int             @default(0)
  totalSpent      Float           @default(0)
  createdAt       DateTime        @default(now())

  orders          Order[]
  supportTickets  SupportTicket[]
  refunds         Refund[]

  @@index([cpfNormalized])
  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([name])
}

model Order {
  id                    String          @id @default(uuid())
  orderNumber           String          @unique // e.g. PED-984521 or DK-98421
  orderNumberNormalized String          @unique
  producerId            String
  eventId               String
  eventName             String
  customerId            String
  customerName          String
  customerCpf           String
  itemsCount            Int             @default(1)
  grossAmount           Float
  serviceFee            Float           @default(0)
  totalAmount           Float
  status                String          @default("PAID") // PAID, PENDING, CANCELLED, REFUNDED
  paymentMethod         String          @default("PIX")  // PIX, CREDIT_CARD, BOLETO
  createdAt             DateTime        @default(now())

  customer              Customer        @relation(fields: [customerId], references: [id])
  producer              Producer        @relation(fields: [producerId], references: [id])
  event                 Event           @relation(fields: [eventId], references: [id])
  tickets               Ticket[]
  payments              Payment[]
  refunds               Refund[]
  supportTickets        SupportTicket[]

  @@index([orderNumberNormalized])
  @@index([producerId])
  @@index([eventId])
  @@index([customerId])
}

model Ticket {
  id                  String   @id @default(uuid())
  ticketCode          String   @unique // e.g. ING-88211 or TKT-98421-01
  ticketCodeNormalized String  @unique
  orderId             String
  eventId             String
  eventName           String
  producerId          String
  sectorName          String
  price               Float
  customerName        String
  customerCpf         String
  nominalAttendee     String
  status              String   @default("VALID") // VALID, USED, CANCELLED
  qrCode              String?
  checkInAt           DateTime?
  createdAt           DateTime @default(now())

  order               Order    @relation(fields: [orderId], references: [id])
  event               Event    @relation(fields: [eventId], references: [id])
  producer            Producer @relation(fields: [producerId], references: [id])

  @@index([ticketCodeNormalized])
  @@index([orderId])
  @@index([eventId])
  @@index([producerId])
}

model Payment {
  id                        String   @id @default(uuid())
  transactionCode           String   @unique // e.g. TRX-552811
  transactionCodeNormalized String   @unique
  orderId                   String
  eventId                   String
  producerId                String
  gateway                   String   @default("PIX_BancoCentral")
  method                    String   @default("PIX")
  amount                    Float
  netAmount                 Float
  status                    String   @default("APPROVED") // APPROVED, PENDING, REFUNDED
  isReconciled              Boolean  @default(true)
  createdAt                 DateTime @default(now())

  order                     Order    @relation(fields: [orderId], references: [id])
  event                     Event    @relation(fields: [eventId], references: [id])
  producer                  Producer @relation(fields: [producerId], references: [id])

  @@index([transactionCodeNormalized])
  @@index([orderId])
  @@index([producerId])
}

model Refund {
  id                   String    @id @default(uuid())
  refundCode           String    @unique // e.g. EST-882
  refundCodeNormalized String    @unique
  orderId              String
  customerId           String
  customerName         String
  eventId              String
  producerId           String
  amount               Float
  reason               String
  status               String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED
  approvedAt           DateTime?
  createdAt            DateTime  @default(now())

  order                Order     @relation(fields: [orderId], references: [id])
  customer             Customer  @relation(fields: [customerId], references: [id])
  event                Event     @relation(fields: [eventId], references: [id])
  producer             Producer  @relation(fields: [producerId], references: [id])

  @@index([refundCodeNormalized])
  @@index([orderId])
  @@index([producerId])
}

model SupportTicket {
  id                   String    @id @default(uuid())
  ticketCode           String    @unique // e.g. ATD-5521
  ticketCodeNormalized String    @unique
  customerId           String
  customerName         String
  orderId              String?
  eventId              String?
  producerId           String?
  channel              String    @default("WHATSAPP") // WHATSAPP, EMAIL, PHONE
  subject              String
  status               String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  priority             String    @default("NORMAL")
  agentName            String?
  slaMinutes           Int       @default(30)
  createdAt            DateTime  @default(now())

  customer             Customer  @relation(fields: [customerId], references: [id])
  order                Order?    @relation(fields: [orderId], references: [id])

  @@index([ticketCodeNormalized])
  @@index([customerId])
  @@index([orderId])
}

model MarketingCampaign {
  id                 String   @id @default(uuid())
  name               String
  nameNormalized     String
  platform           String   // META, GOOGLE, TIKTOK
  eventId            String
  eventName          String
  producerId         String
  status             String   @default("ACTIVE") // ACTIVE, PAUSED, ENDED
  spend              Float    @default(0)
  attributedRevenue  Float    @default(0)
  roas               Float    @default(0)
  cpa                Float    @default(0)
  createdAt          DateTime @default(now())

  event              Event    @relation(fields: [eventId], references: [id])
  producer           Producer @relation(fields: [producerId], references: [id])

  @@index([nameNormalized])
  @@index([eventId])
  @@index([producerId])
}

model SearchHistory {
  id         String   @id @default(uuid())
  userId     String
  query      String
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ------------------------------------------------------------------------------
// 9. MOTOR CENTRAL DE APROVAÇÕES, ALÇADAS E DUPLA VALIDAÇÃO (FASE 1.1.5.7)
// ------------------------------------------------------------------------------

model ApprovalRule {
  id                       String    @id @default(uuid())
  code                     String    @unique // e.g. RULE_FIN_TRANSFER_TIER_1
  name                     String
  description              String?
  operation                String    // FINANCE_TRANSFER, REFUND_REQUEST, ADMIN_PERMISSION_CHANGE, etc.
  producerId               String?   // null = GLOBAL
  eventId                  String?   // null = all events
  minAmount                Float?    @default(0)
  maxAmount                Float?
  approvalsRequired        Int       @default(1)
  isSequential             Boolean   @default(false)
  requireDistinctApprovers Boolean   @default(true)
  prohibitSelfApproval     Boolean   @default(true) // SOLICITANTE != APROVADOR
  requireStepUp            Boolean   @default(false)
  require2FA               Boolean   @default(false)
  requireComment           Boolean   @default(false)
  requiredDocuments        String?   // JSON array of required doc types
  slaMinutes               Int?      @default(120)
  escalationTimeoutMinutes Int?
  escalationRole           String?
  allowedRoles             String    // JSON array of role codes, e.g. ["FINANCEIRO", "ADMINISTRADOR_GERAL"]
  version                  Int       @default(1)
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  requests                 ApprovalRequest[]

  @@index([operation, isActive])
  @@index([producerId])
  @@index([eventId])
}

model ApprovalThreshold {
  id                 String   @id @default(uuid())
  userId             String?
  roleId             String?
  roleCode           String?
  operation          String   // FINANCE_TRANSFER, REFUND_REQUEST, etc.
  maxApprovalAmount  Float    // Upper bound amount authorized for this user/role
  producerId         String?  // Scope restriction
  eventId            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, operation])
  @@index([roleCode, operation])
}

model ApprovalRequest {
  id                 String    @id @default(uuid())
  requestCode        String    @unique // e.g. APR-1001
  operation          String    // FINANCE_TRANSFER, REFUND_REQUEST, etc.
  title              String
  description        String?
  resourceType       String    // FINANCE_TRANSFER, REFUND, USER_PERMISSION, EVENT
  resourceId         String
  amount             Float?
  producerId         String?
  eventId            String?
  requesterId        String
  requesterName      String
  requesterRole      String?
  ruleId             String
  ruleVersion        Int       @default(1)
  policySnapshot     String    // JSON snapshot of the rule at creation time (immutable)
  status             String    @default("PENDING") // DRAFT, PENDING, IN_REVIEW, CHANGES_REQUESTED, PARTIALLY_APPROVED, APPROVED, REJECTED, CANCELLED, EXECUTING, EXECUTED, FAILED
  approvalsCount     Int       @default(0)
  approvalsRequired  Int       @default(1)
  currentStep        Int       @default(1)
  executionKey       String?   @unique // Idempotency key
  executionResult    String?   // JSON result of executed action
  executedAt         DateTime?
  executionError     String?
  expiresAt          DateTime?
  isEscalated        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  rule               ApprovalRule         @relation(fields: [ruleId], references: [id])
  steps              ApprovalStep[]
  decisions          ApprovalDecision[]
  comments           ApprovalComment[]
  attachments        ApprovalAttachment[]

  @@index([status])
  @@index([requesterId])
  @@index([producerId])
  @@index([eventId])
  @@index([createdAt])
}

model ApprovalStep {
  id                 String    @id @default(uuid())
  requestId          String
  stepOrder          Int       @default(1)
  roleCode           String?
  groupId            String?
  status             String    @default("PENDING") // PENDING, APPROVED, REJECTED, SKIPPED
  approvedByUserId   String?
  approvedByUserName String?
  decision           String?   // APPROVED, REJECTED, CHANGES_REQUESTED
  comment            String?
  stepUpVerified     Boolean   @default(false)
  decidedAt          DateTime?
  createdAt          DateTime  @default(now())

  request            ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, stepOrder])
}

model ApprovalDecision {
  id                  String   @id @default(uuid())
  requestId           String
  userId              String
  userName            String
  userRole            String?
  decision            String   // APPROVED, REJECTED, CHANGES_REQUESTED, CANCELLED
  comment             String?
  reasonCategory      String?  // SALDO, DOCUMENTACAO, REGRA, OUTRO
  isDelegated         Boolean  @default(false)
  delegatedFromUserId String?
  stepUpToken         String?
  createdAt           DateTime @default(now())

  request             ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([userId])
}

model ApprovalDelegation {
  id                  String   @id @default(uuid())
  fromUserId          String
  fromUserName        String?
  toUserId            String
  toUserName          String?
  module              String?  // FINANCEIRO, ESTORNO, null = ALL
  startDate           DateTime
  endDate             DateTime
  status              String   @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  createdAt           DateTime @default(now())

  @@index([fromUserId, status])
  @@index([toUserId, status])
}

model ApprovalComment {
  id         String   @id @default(uuid())
  requestId  String
  userId     String
  userName   String
  comment    String
  createdAt  DateTime @default(now())

  request    ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model ApprovalAttachment {
  id                 String   @id @default(uuid())
  requestId          String
  documentType       String   // NOTA_FISCAL, COMPROVANTE, AUTORIZACAO, CONTRATO
  fileName           String
  fileUrl            String
  fileSize           Int?
  mimeType           String?
  uploadedByUserId   String
  uploadedByUserName String
  createdAt          DateTime @default(now())

  request            ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model ApprovalGroup {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  members     ApprovalGroupMember[]
}

model ApprovalGroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group     ApprovalGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}
