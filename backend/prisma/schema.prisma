  migrationId  String
  entityType   String
  sourceCount  Int
  destCount    Int
  countMatched Boolean
  sourceSum    Float?
  destSum      Float?
  sumMatched   Boolean?
  divergentIds String   // JSON
  reconciledAt DateTime @default(now())

