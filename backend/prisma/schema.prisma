  entity          String
  entityId        String
  field           String?
  dimension       String
  severity        String
  description     String
  suggestedAction String
  taskId          String?
  status          String    @default("OPEN")
  detectedAt      DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([ruleCode])
  @@index([entity, entityId])
  @@index([status])
}

model MigrationProjectModel {
