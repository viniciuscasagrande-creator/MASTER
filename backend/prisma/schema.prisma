// ==============================================================================
// DISK INTERNO - PRISMA ORM SCHEMA (PostgreSQL)
// Fase 1.1.5.1: Core Node.js Real - Autenticacao + RBAC + Escopo Produtor/Evento
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}

enum ScopeType {
  GLOBAL
  PRODUCER
  EVENT
}

// ------------------------------------------------------------------------------
// 1. USUÁRIO E IDENTIDADE
// ------------------------------------------------------------------------------

model User {
  id                String               @id @default(uuid())
  name              String
  email             String               @unique
  passwordHash      String
  status            UserStatus           @default(ACTIVE)
  isSuperAdmin      Boolean              @default(false)
  twoFactorEnabled  Boolean              @default(false)
  twoFactorSecret   String?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  // Relações do Core de Identidade
  userRoles         UserRole[]
  userPermissions   UserPermission[]
  producerAccesses  UserProducerAccess[]
  eventAccesses     UserEventAccess[]
  sessions          Session[]
  auditLogs         AuditLog[]
  notifications     NotificationRecipient[]
  preferences       NotificationPreference[]

  @@index([email])
  @@index([status])
}

// ------------------------------------------------------------------------------
// 2. PERFIS (ROLES)
// ------------------------------------------------------------------------------

model Role {
  id              String           @id @default(uuid())
  name            String
  code            String           @unique // Ex: ADMINISTRADOR_GERAL, FINANCEIRO
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([code])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ------------------------------------------------------------------------------
// 3. PERMISSÕES GRANULARES (PERMISSION ENGINE)
// ------------------------------------------------------------------------------

model Permission {
  id              String           @id @default(uuid())
  module          String           // Ex: financeiro, eventos, sac
  resource        String           // Ex: transferencia, saldo, pedido
  action          String           // Ex: visualizar, criar, aprovar
  code            String           @unique // Ex: financeiro.transferencia.aprovar
  description     String?
  createdAt       DateTime         @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([code])
  @@index([module])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  isGranted    Boolean    @default(true) // true = concessão direta, false = revogação explícita
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
}

// ------------------------------------------------------------------------------
// 4. ESCOPO DE DADOS: PRODUTOR & EVENTO
// ------------------------------------------------------------------------------

model Producer {
  id             String               @id @default(uuid())
  name           String
  cnpj           String               @unique
  email          String?
  phone          String?
  status         String               @default("ACTIVE")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  events         Event[]
  userAccesses   UserProducerAccess[]

  @@index([cnpj])
}

model Event {
  id              String            @id @default(uuid())
  publicCode      String            @unique
  producerId      String

  name            String
  title           String?           // For backwards compatibility
  slug            String?
  description     String?

  status          String            @default("DRAFT")

  categoryId      String?

  startAt         DateTime?
  endAt           DateTime?
  eventDate       DateTime?         // Backwards compatibility
  timezone        String            @default("America/Sao_Paulo")

  venue           String?
  city            String?
  state           String?
  country         String            @default("BR")

  capacity        Int?
  soldTickets     Int?              @default(0)

  coverDocumentId String?

  createdBy       String?
  createdAt       DateTime          @default(now())

  updatedBy       String?
  updatedAt       DateTime          @updatedAt

  archivedAt      DateTime?

  producer        Producer          @relation(fields: [producerId], references: [id], onDelete: Restrict)
  userAccesses    UserEventAccess[]

  @@index([producerId])
  @@index([producerId, status])
  @@index([startAt])
  @@index([name])
}


model UserProducerAccess {
  id         String   @id @default(uuid())
  userId     String
  producerId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@unique([userId, producerId])
  @@index([userId])
  @@index([producerId])
}

model UserEventAccess {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

// ------------------------------------------------------------------------------
// 5. CONTROLE DE SESSÕES (JWT REFRESH)
// ------------------------------------------------------------------------------

model Session {
  id           String    @id @default(uuid())
  userId       String
  token        String    @unique
  refreshToken String?   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([refreshToken])
}

// ------------------------------------------------------------------------------
// 6. TRILHA DE AUDITORIA IMUTÁVEL
// ------------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  correlationId String?
  requestId     String?
  userId        String?
  userName      String?
  sessionId     String?
  module        String?  // FINANCE, EVENTS, SAC, REFUNDS, MARKETING, SECURITY, etc.
  action        String
  resource      String
  resourceType  String?
  resourceId    String?
  producerId    String?
  eventId       String?
  beforeData    String?  // JSON stringified
  afterData     String?  // JSON stringified
  details       String?
  ipAddress     String?
  ipHash        String?
  userAgent     String?
  result        String   @default("SUCCESS") // SUCCESS, DENIED, FAILED
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([correlationId])
  @@index([requestId])
  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([resource])
  @@index([producerId])
  @@index([eventId])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// 7. NOTIFICAÇÕES, OUTBOX & REAL-TIME (FASE 1.1.5.5)
// ------------------------------------------------------------------------------

model Notification {
  id           String    @id @default(uuid())
  type         String    // INFO, SUCCESS, WARNING, CRITICAL, ACTION_REQUIRED
  priority     String    @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  module       String    // FINANCE, EVENTS, SAC, REFUNDS, MARKETING, SECURITY, etc.
  title        String
  description  String
  groupKey     String?   // For anti-noise deduplication & grouping (e.g. sales:evt_1001)
  resourceType String?   // TRANSFER, ORDER, TICKET, INCIDENT, EVENT, etc.
  resourceId   String?
  actionUrl    String?   // e.g. /finance/transfers/trf_123
  producerId   String?
  eventId      String?
  metadata     String?   // JSON stringified extra payload
  createdAt    DateTime  @default(now())

  recipients   NotificationRecipient[]

  @@index([module])
  @@index([groupKey])
  @@index([createdAt])
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId String
  userId         String
  status         String       @default("UNREAD") // UNREAD, READ, ARCHIVED, DISMISSED
  readAt         DateTime?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, status])
}

model NotificationPreference {
  id             String   @id @default(uuid())
  userId         String
  module         String
  channel        String   @default("IN_APP") // IN_APP, EMAIL, WHATSAPP
  isEnabled      Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module, channel])
  @@index([userId])
}

model NotificationRule {
  id              String   @id @default(uuid())
  eventType       String   @unique // e.g. FINANCE_TRANSFER_CREATED
  requiredPerm    String?  // e.g. financeiro.transferencia.aprovar
  defaultPriority String   @default("NORMAL")
  type            String   @default("INFO")
  isMandatory     Boolean  @default(false) // If true, cannot be disabled by user preferences (e.g. security)
  createdAt       DateTime @default(now())
}

model EventOutbox {
  id            String    @id @default(uuid())
  eventId       String    @unique // Unique event ID for idempotency
  eventType     String
  correlationId String?
  producerId    String?
  eventIdRef    String?
  resourceType  String?
  resourceId    String?
  actorUserId   String?
  payload       String    // JSON stringified payload
  status        String    @default("PENDING") // PENDING, PROCESSED, FAILED
  retryCount    Int       @default(0)
  errorMessage  String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([status])
  @@index([correlationId])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// 8. CENTRAL DE CONSULTA & DOMÍNIOS OPERACIONAIS (FASE 1.1.5.6)
// ------------------------------------------------------------------------------

model Customer {
  id              String          @id @default(uuid())
  name            String
  cpf             String          @unique
  cpfNormalized   String          @unique
  email           String
  emailNormalized String
  phone           String
  phoneNormalized String
  city            String?
  state           String?
  totalOrders     Int             @default(0)
  totalSpent      Float           @default(0)
  createdAt       DateTime        @default(now())

  orders          Order[]
  supportTickets  SupportTicket[]
  refunds         Refund[]

  @@index([cpfNormalized])
  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([name])
}

model Order {
  id                    String          @id @default(uuid())
  orderNumber           String          @unique // e.g. PED-984521 or DK-98421
  orderNumberNormalized String          @unique
  producerId            String
  eventId               String
  eventName             String
  customerId            String
  customerName          String
  customerCpf           String
  itemsCount            Int             @default(1)
  grossAmount           Float
  serviceFee            Float           @default(0)
  totalAmount           Float
  status                String          @default("PAID") // PAID, PENDING, CANCELLED, REFUNDED
  paymentMethod         String          @default("PIX")  // PIX, CREDIT_CARD, BOLETO
  createdAt             DateTime        @default(now())

  customer              Customer        @relation(fields: [customerId], references: [id])
  producer              Producer        @relation(fields: [producerId], references: [id])
  event                 Event           @relation(fields: [eventId], references: [id])
  tickets               Ticket[]
  payments              Payment[]
  refunds               Refund[]
  supportTickets        SupportTicket[]

  @@index([orderNumberNormalized])
  @@index([producerId])
  @@index([eventId])
  @@index([customerId])
}

model Ticket {
  id                  String   @id @default(uuid())
  ticketCode          String   @unique // e.g. ING-88211 or TKT-98421-01
  ticketCodeNormalized String  @unique
  orderId             String
  eventId             String
  eventName           String
  producerId          String
  sectorName          String
  price               Float
  customerName        String
  customerCpf         String
  nominalAttendee     String
  status              String   @default("VALID") // VALID, USED, CANCELLED
  qrCode              String?
  checkInAt           DateTime?
  createdAt           DateTime @default(now())

  order               Order    @relation(fields: [orderId], references: [id])
  event               Event    @relation(fields: [eventId], references: [id])
  producer            Producer @relation(fields: [producerId], references: [id])

  @@index([ticketCodeNormalized])
  @@index([orderId])
  @@index([eventId])
  @@index([producerId])
}

model Payment {
  id                        String   @id @default(uuid())
  transactionCode           String   @unique // e.g. TRX-552811
  transactionCodeNormalized String   @unique
  orderId                   String
  eventId                   String
  producerId                String
  gateway                   String   @default("PIX_BancoCentral")
  method                    String   @default("PIX")
  amount                    Float
  netAmount                 Float
  status                    String   @default("APPROVED") // APPROVED, PENDING, REFUNDED
  isReconciled              Boolean  @default(true)
  createdAt                 DateTime @default(now())

  order                     Order    @relation(fields: [orderId], references: [id])
  event                     Event    @relation(fields: [eventId], references: [id])
  producer                  Producer @relation(fields: [producerId], references: [id])

  @@index([transactionCodeNormalized])
  @@index([orderId])
  @@index([producerId])
}

model Refund {
  id                   String    @id @default(uuid())
  refundCode           String    @unique // e.g. EST-882
  refundCodeNormalized String    @unique
  orderId              String
  customerId           String
  customerName         String
  eventId              String
  producerId           String
  amount               Float
  reason               String
  status               String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED
  approvedAt           DateTime?
  createdAt            DateTime  @default(now())

  order                Order     @relation(fields: [orderId], references: [id])
  customer             Customer  @relation(fields: [customerId], references: [id])
  event                Event     @relation(fields: [eventId], references: [id])
  producer             Producer  @relation(fields: [producerId], references: [id])

  @@index([refundCodeNormalized])
  @@index([orderId])
  @@index([producerId])
}

model SupportTicket {
  id                   String    @id @default(uuid())
  ticketCode           String    @unique // e.g. ATD-5521
  ticketCodeNormalized String    @unique
  customerId           String
  customerName         String
  orderId              String?
  eventId              String?
  producerId           String?
  channel              String    @default("WHATSAPP") // WHATSAPP, EMAIL, PHONE
  subject              String
  status               String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  priority             String    @default("NORMAL")
  agentName            String?
  slaMinutes           Int       @default(30)
  createdAt            DateTime  @default(now())

  customer             Customer  @relation(fields: [customerId], references: [id])
  order                Order?    @relation(fields: [orderId], references: [id])

  @@index([ticketCodeNormalized])
  @@index([customerId])
  @@index([orderId])
}

model MarketingCampaign {
  id                 String   @id @default(uuid())
  name               String
  nameNormalized     String
  platform           String   // META, GOOGLE, TIKTOK
  eventId            String
  eventName          String
  producerId         String
  status             String   @default("ACTIVE") // ACTIVE, PAUSED, ENDED
  spend              Float    @default(0)
  attributedRevenue  Float    @default(0)
  roas               Float    @default(0)
  cpa                Float    @default(0)
  createdAt          DateTime @default(now())

  event              Event    @relation(fields: [eventId], references: [id])
  producer           Producer @relation(fields: [producerId], references: [id])

  @@index([nameNormalized])
  @@index([eventId])
  @@index([producerId])
}

model SearchHistory {
  id         String   @id @default(uuid())
  userId     String
  query      String
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ------------------------------------------------------------------------------
// 9. MOTOR CENTRAL DE APROVAÇÕES, ALÇADAS E DUPLA VALIDAÇÃO (FASE 1.1.5.7)
// ------------------------------------------------------------------------------

model ApprovalRule {
  id                       String    @id @default(uuid())
  code                     String    @unique // e.g. RULE_FIN_TRANSFER_TIER_1
  name                     String
  description              String?
  operation                String    // FINANCE_TRANSFER, REFUND_REQUEST, ADMIN_PERMISSION_CHANGE, etc.
  producerId               String?   // null = GLOBAL
  eventId                  String?   // null = all events
  minAmount                Float?    @default(0)
  maxAmount                Float?
  approvalsRequired        Int       @default(1)
  isSequential             Boolean   @default(false)
  requireDistinctApprovers Boolean   @default(true)
  prohibitSelfApproval     Boolean   @default(true) // SOLICITANTE != APROVADOR
  requireStepUp            Boolean   @default(false)
  require2FA               Boolean   @default(false)
  requireComment           Boolean   @default(false)
  requiredDocuments        String?   // JSON array of required doc types
  slaMinutes               Int?      @default(120)
  escalationTimeoutMinutes Int?
  escalationRole           String?
  allowedRoles             String    // JSON array of role codes, e.g. ["FINANCEIRO", "ADMINISTRADOR_GERAL"]
  version                  Int       @default(1)
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  requests                 ApprovalRequest[]

  @@index([operation, isActive])
  @@index([producerId])
  @@index([eventId])
}

model ApprovalThreshold {
  id                 String   @id @default(uuid())
  userId             String?
  roleId             String?
  roleCode           String?
  operation          String   // FINANCE_TRANSFER, REFUND_REQUEST, etc.
  maxApprovalAmount  Float    // Upper bound amount authorized for this user/role
  producerId         String?  // Scope restriction
  eventId            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, operation])
  @@index([roleCode, operation])
}

model ApprovalRequest {
  id                 String    @id @default(uuid())
  requestCode        String    @unique // e.g. APR-1001
  operation          String    // FINANCE_TRANSFER, REFUND_REQUEST, etc.
  title              String
  description        String?
  resourceType       String    // FINANCE_TRANSFER, REFUND, USER_PERMISSION, EVENT
  resourceId         String
  amount             Float?
  producerId         String?
  eventId            String?
  requesterId        String
  requesterName      String
  requesterRole      String?
  ruleId             String
  ruleVersion        Int       @default(1)
  policySnapshot     String    // JSON snapshot of the rule at creation time (immutable)
  status             String    @default("PENDING") // DRAFT, PENDING, IN_REVIEW, CHANGES_REQUESTED, PARTIALLY_APPROVED, APPROVED, REJECTED, CANCELLED, EXECUTING, EXECUTED, FAILED
  approvalsCount     Int       @default(0)
  approvalsRequired  Int       @default(1)
  currentStep        Int       @default(1)
  executionKey       String?   @unique // Idempotency key
  executionResult    String?   // JSON result of executed action
  executedAt         DateTime?
  executionError     String?
  expiresAt          DateTime?
  isEscalated        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  rule               ApprovalRule         @relation(fields: [ruleId], references: [id])
  steps              ApprovalStep[]
  decisions          ApprovalDecision[]
  comments           ApprovalComment[]
  attachments        ApprovalAttachment[]

  @@index([status])
  @@index([requesterId])
  @@index([producerId])
  @@index([eventId])
  @@index([createdAt])
}

model ApprovalStep {
  id                 String    @id @default(uuid())
  requestId          String
  stepOrder          Int       @default(1)
  roleCode           String?
  groupId            String?
  status             String    @default("PENDING") // PENDING, APPROVED, REJECTED, SKIPPED
  approvedByUserId   String?
  approvedByUserName String?
  decision           String?   // APPROVED, REJECTED, CHANGES_REQUESTED
  comment            String?
  stepUpVerified     Boolean   @default(false)
  decidedAt          DateTime?
  createdAt          DateTime  @default(now())

  request            ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, stepOrder])
}

model ApprovalDecision {
  id                  String   @id @default(uuid())
  requestId           String
  userId              String
  userName            String
  userRole            String?
  decision            String   // APPROVED, REJECTED, CHANGES_REQUESTED, CANCELLED
  comment             String?
  reasonCategory      String?  // SALDO, DOCUMENTACAO, REGRA, OUTRO
  isDelegated         Boolean  @default(false)
  delegatedFromUserId String?
  stepUpToken         String?
  createdAt           DateTime @default(now())

  request             ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([userId])
}

model ApprovalDelegation {
  id                  String   @id @default(uuid())
  fromUserId          String
  fromUserName        String?
  toUserId            String
  toUserName          String?
  module              String?  // FINANCEIRO, ESTORNO, null = ALL
  startDate           DateTime
  endDate             DateTime
  status              String   @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  createdAt           DateTime @default(now())

  @@index([fromUserId, status])
  @@index([toUserId, status])
}

model ApprovalComment {
  id         String   @id @default(uuid())
  requestId  String
  userId     String
  userName   String
  comment    String
  createdAt  DateTime @default(now())

  request    ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model ApprovalAttachment {
  id                 String   @id @default(uuid())
  requestId          String
  documentType       String   // NOTA_FISCAL, COMPROVANTE, AUTORIZACAO, CONTRATO
  fileName           String
  fileUrl            String
  fileSize           Int?
  mimeType           String?
  uploadedByUserId   String
  uploadedByUserName String
  createdAt          DateTime @default(now())

  request            ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model ApprovalGroup {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  members     ApprovalGroupMember[]
}

model ApprovalGroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group     ApprovalGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

// ==========================================
// 10. CENTRAL DE ARQUIVOS, DOCUMENTOS E ANEXOS (FASE 1.1.5.8)
// ==========================================

model Document {
  id               String            @id @default(uuid())
  organizationId   String?           @default("org-disk-ingressos")
  producerId       String?
  eventId          String?
  title            String
  description      String?
  categoryId       String
  status           String            @default("AVAILABLE") // PROCESSING, AVAILABLE, REJECTED, QUARANTINED, EXPIRED, ARCHIVED, DELETED
  isConfidential   Boolean           @default(false)
  validFrom        DateTime?
  validUntil       DateTime?
  createdBy        String
  currentVersionId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  category         DocumentCategory  @relation(fields: [categoryId], references: [id])
  versions         DocumentVersion[]
  links            DocumentLink[]
  accessLogs       DocumentAccessLog[]
  tagLinks         DocumentTagLink[]

  @@index([status])
  @@index([producerId])
  @@index([eventId])
  @@index([categoryId])
  @@index([validUntil])
}

model DocumentVersion {
  id                String            @id @default(uuid())
  documentId        String
  version           Int               @default(1)
  storageKey        String
  originalFileName  String
  mimeType          String
  size              Int
  checksumAlgorithm String            @default("SHA-256")
  checksum          String
  changeReason      String?
  uploadedByUserId  String
  createdAt         DateTime          @default(now())

  document          Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  securityChecks    DocumentSecurityCheck[]
  accessLogs        DocumentAccessLog[]

  @@unique([documentId, version])
  @@index([documentId])
  @@index([storageKey])
}

model DocumentLink {
  id           String    @id @default(uuid())
  documentId   String
  resourceType String    // PRODUCER, EVENT, ORDER, TICKET, PAYMENT, TRANSFER, REFUND, SUPPORT_TICKET, SUPPLIER, CONTRACT, CAMPAIGN, APPROVAL_REQUEST
  resourceId   String
  producerId   String?
  eventId      String?
  createdAt    DateTime  @default(now())

  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([resourceType, resourceId])
  @@index([producerId])
  @@index([eventId])
}

model DocumentCategory {
  id               String            @id @default(uuid())
  code             String            @unique // CONTRATO, NOTA_FISCAL, COMPROVANTE, BOLETO, EXTRATO, AUTORIZACAO, DOCUMENTO_FISCAL, DOCUMENTO_CONTABIL, DOCUMENTO_BANCARIO, RELATORIO, EVIDENCIA, ANEXO_ATENDIMENTO, DOCUMENTO_EVENTO, CRIATIVO, OUTRO
  name             String
  description      String?
  retentionDays    Int?              // null = permanent / policy based
  isSensitive      Boolean           @default(false)
  allowedMimeTypes String?           // JSON array or comma separated
  maxSizeBytes     Int?              @default(52428800) // 50MB default
  createdAt        DateTime          @default(now())

  documents        Document[]
  retentionPolicies DocumentRetentionPolicy[]
}

model DocumentTag {
  id        String            @id @default(uuid())
  name      String            @unique
  createdAt DateTime          @default(now())

  tagLinks  DocumentTagLink[]
}

model DocumentTagLink {
  id         String      @id @default(uuid())
  documentId String
  tagId      String

  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        DocumentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([documentId, tagId])
  @@index([documentId])
  @@index([tagId])
}

model DocumentAccessLog {
  id         String           @id @default(uuid())
  documentId String
  versionId  String?
  userId     String
  userName   String?
  action     String           // VIEW, DOWNLOAD, PREVIEW, VERSION_CREATE, ARCHIVE, DELETE_REQUEST, DELETE, PERMISSION_DENIED, QUARANTINED, LINK_CREATE, LINK_DELETE
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime         @default(now())

  document   Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    DocumentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([userId])
  @@index([createdAt])
}

model DocumentSecurityCheck {
  id         String          @id @default(uuid())
  versionId  String
  status     String          // PASSED, QUARANTINED, REJECTED
  scanResult String?
  threatName String?
  scannedAt  DateTime        @default(now())

  version    DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([status])
}

model DocumentRetentionPolicy {
  id            String           @id @default(uuid())
  categoryId    String
  producerId    String?
  retentionDays Int
  action        String           @default("ARCHIVE") // ARCHIVE, PERMANENT_DELETE
  createdAt     DateTime         @default(now())

  category      DocumentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model DocumentRequirement {
  id                 String   @id @default(uuid())
  operation          String   // FINANCE_TRANSFER, REFUND_REQUEST, FINANCE_ADVANCE, FINANCE_PAYMENT, APPROVAL
  producerId         String?
  eventId            String?
  minAmount          Float?
  maxAmount          Float?
  requiredCategories String   // JSON array of category codes: '["NOTA_FISCAL", "AUTORIZACAO"]'
  createdAt          DateTime @default(now())

  @@index([operation])
  @@index([producerId])
  @@index([eventId])
}

// ============================================================================
// SEÇÃO 11: MOTOR CENTRAL DE TAREFAS, PENDÊNCIAS E FLUXOS (Fase 1.1.5.9)
// ============================================================================

model Task {
  id                    String    @id @default(uuid())
  taskNumber            String    @unique // e.g. TSK-8821
  title                 String
  description           String?
  module                String    // FINANCEIRO, SAC, EVENTOS, ESTORNO, CONTABILIDADE, MARKETING, COMERCIAL, OPERACOES, SEGURANCA, GERAL
  type                  String    // INVESTIGATE_DIVERGENCE, REVIEW_REFUND_DOCS, VALIDATE_INVOICE, etc.
  priority              String    @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  status                String    @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, WAITING, BLOCKED, COMPLETED, CANCELLED
  waitingReason         String?   // CLIENTE, PRODUTOR, FORNECEDOR, BANCO, GATEWAY, OUTRO_DEPARTAMENTO
  blockedReason         String?
  assignedUserId        String?
  assignedUserName      String?
  assignedTeamId        String?
  assignedTeamName      String?
  organizationId        String?
  producerId            String?
  producerName          String?
  eventId               String?
  eventName             String?
  resourceType          String?   // ORDER, CUSTOMER, EVENT, PAYMENT, TRANSFER, REFUND, SUPPORT_TICKET, CAMPAIGN, DOCUMENT
  resourceId            String?
  workflowId            String?
  workflowRuleId        String?
  templateId            String?
  slaPolicyId           String?
  dueAt                 DateTime?
  slaStartedAt          DateTime?
  slaPausedAt           DateTime?
  slaResumedAt          DateTime?
  slaDeadline           DateTime?
  slaStatus             String    @default("WITHIN_SLA") // WITHIN_SLA, NEARING_BREACH, BREACHED, PAUSED
  totalPausedDurationMs Int       @default(0)
  estimatedMinutes      Int?
  startedAt             DateTime?
  completedAt           DateTime?
  completedByUserId     String?
  cancelledAt           DateTime?
  cancelledByUserId     String?
  cancelReason          String?
  reopenedAt            DateTime?
  reopenedByUserId      String?
  reopenReason          String?
  escalationLevel       Int       @default(0)
  createdBy             String
  creatorName           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  assignments           TaskAssignment[]
  checklists            TaskChecklist[]
  checklistItems        TaskChecklistItem[]
  comments              TaskComment[]
  history               TaskHistory[]
  dependencies          TaskDependency[]      @relation("TaskDependencies")
  dependentOnMe         TaskDependency[]      @relation("TaskDependentOnMe")
  slaEvents             SlaEvent[]
  escalationEvents      EscalationEvent[]

  @@index([status])
  @@index([priority])
  @@index([module])
  @@index([assignedUserId])
  @@index([assignedTeamId])
  @@index([producerId])
  @@index([eventId])
  @@index([resourceType, resourceId])
  @@index([dueAt])
  @@index([slaStatus])
  @@index([createdAt])
}

model TaskAssignment {
  id               String   @id @default(uuid())
  taskId           String
  fromUserId       String?
  toUserId         String?
  fromTeamId       String?
  toTeamId         String?
  assignmentType   String   @default("MANUAL") // MANUAL, ROUTER_AUTO, ROUTER_ROUND_ROBIN, ROUTER_WORKLOAD, ROUTER_DUTY, CLAIMED
  reason           String?
  comment          String?
  assignedByUserId String?
  createdAt        DateTime @default(now())

  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([toUserId])
  @@index([toTeamId])
}

model TaskChecklist {
  id        String   @id @default(uuid())
  taskId    String
  title     String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskChecklistItem {
  id                String    @id @default(uuid())
  taskId            String
  text              String
  isRequired        Boolean   @default(false)
  isCompleted       Boolean   @default(false)
  completedByUserId String?
  completedAt       DateTime?
  orderIndex        Int       @default(0)

  task              Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskComment {
  id         String   @id @default(uuid())
  taskId     String
  userId     String
  userName   String?
  userAvatar String?
  content    String
  mentions   String?  // JSON array: '["usr-carlos", "team-financeiro"]'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

model TaskDependency {
  id              String   @id @default(uuid())
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  task            Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task     @relation("TaskDependentOnMe", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
}

model TaskHistory {
  id        String   @id @default(uuid())
  taskId    String
  userId    String?
  userName  String?
  action    String   // CREATED, ASSIGNED, CLAIMED, STARTED, WAITING, RESUMED, CHECKLIST_ITEM_COMPLETED, COMMENT_ADDED, DOCUMENT_LINKED, REASSIGNED, ESCALATED, COMPLETED, REOPENED, CANCELLED
  details   String?  // JSON string
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
}

model Team {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique // FINANCEIRO, SAC, ESTORNO, SUPORTE_EVENTOS, CONTABILIDADE, MARKETING, OPERACOES, SEGURANCA
  description    String?
  leaderUserId   String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members        TeamMember[]
  dutySchedules  DutySchedule[]

  @@index([code])
  @@index([isActive])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      String   @default("ANALYST") // LEADER, SUPERVISOR, ANALYST, MEMBER
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Workflow {
  id             String            @id @default(uuid())
  name           String
  description    String?
  module         String            // FINANCEIRO, SAC, EVENTOS, ESTORNO, CONTABILIDADE, MARKETING, SEGURANCA
  triggerEvent   String            // RECONCILIATION_DIVERGENCE_DETECTED, REFUND_REQUESTED, TICKET_CREATED, etc.
  isActive       Boolean           @default(true)
  currentVersion Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  versions       WorkflowVersion[]
  rules          WorkflowRule[]

  @@index([module])
  @@index([triggerEvent])
  @@index([isActive])
}

model WorkflowVersion {
  id              String   @id @default(uuid())
  workflowId      String
  version         Int
  rulesSnapshot   String   // JSON array of rules
  changeReason    String?
  createdByUserId String
  createdAt       DateTime @default(now())

  workflow        Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([workflowId])
}

model WorkflowRule {
  id            String           @id @default(uuid())
  workflowId    String
  version       Int              @default(1)
  name          String?
  conditionJson String           // JSON rules
  actionJson    String           // JSON action specs
  priority      String           @default("NORMAL")
  slaMinutes    Int              @default(120)
  targetTeamId  String?
  orderIndex    Int              @default(0)

  workflow      Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  actions       WorkflowAction[]

  @@index([workflowId])
}

model WorkflowAction {
  id             String       @id @default(uuid())
  workflowRuleId String
  actionType     String       // CREATE_TASK, NOTIFY, ROUTE_TEAM, FORWARD_APPROVAL
  payload        String       // JSON payload

  rule           WorkflowRule @relation(fields: [workflowRuleId], references: [id], onDelete: Cascade)

  @@index([workflowRuleId])
}

model TaskTemplate {
  id                      String   @id @default(uuid())
  code                    String   @unique
  title                   String
  description             String?
  module                  String
  priority                String   @default("NORMAL")
  defaultEstimatedMinutes Int      @default(120)
  targetTeamCode          String?
  checklistTemplate       String?  // JSON array of items: '[{"text": "Conferir pedido", "isRequired": true}]'
  createdAt               DateTime @default(now())

  @@index([code])
  @@index([module])
}

model SlaPolicy {
  id                      String   @id @default(uuid())
  name                    String
  module                  String
  priority                String   @default("NORMAL")
  durationMinutes         Int      @default(120)
  warningThresholdPercent Int      @default(80)
  criticalThresholdPercent Int     @default(95)
  allowPause              Boolean  @default(true)
  allowedPauseReasons     String   // JSON array: '["CLIENTE", "PRODUTOR", "FORNECEDOR", "BANCO", "GATEWAY", "OUTRO_DEPARTAMENTO"]'
  createdAt               DateTime @default(now())

  escalationRules         EscalationRule[]

  @@index([module, priority])
}

model SlaEvent {
  id        String   @id @default(uuid())
  taskId    String
  eventType String   // STARTED, PAUSED, RESUMED, WARNING_80, CRITICAL_95, BREACHED
  details   String?
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([eventType])
}

model EscalationRule {
  id                       String     @id @default(uuid())
  slaPolicyId              String?
  module                   String?
  level                    Int        @default(1)
  triggerMinutesAfterBreach Int       @default(30)
  escalateToRole           String     // SUPERVISOR, MANAGER, ADMIN
  escalateToTeamId         String?
  notifyChannels           String     // JSON array: '["WEBSOCKET", "EMAIL", "NOTIFICATION"]'
  createdAt                DateTime   @default(now())

  slaPolicy                SlaPolicy? @relation(fields: [slaPolicyId], references: [id], onDelete: Cascade)

  @@index([slaPolicyId])
  @@index([module])
}

model EscalationEvent {
  id                String   @id @default(uuid())
  taskId            String
  fromLevel         Int
  toLevel           Int
  escalatedToUserId String?
  reason            String
  createdAt         DateTime @default(now())

  task              Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model UserAvailability {
  id                   String    @id @default(uuid())
  userId               String    @unique
  status               String    @default("AVAILABLE") // AVAILABLE, BUSY, AWAY, VACATION, INACTIVE
  currentWorkloadScore Int       @default(0)
  lastAssignedAt       DateTime?
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model DutySchedule {
  id            String   @id @default(uuid())
  teamId        String
  producerId    String?
  eventId       String?
  shiftStart    String   // e.g. "18:00"
  shiftEnd      String   // e.g. "00:00"
  activeUserIds String   // JSON array of user IDs
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([eventId])
  @@index([isActive])
}

// ==========================================
// 12. MOTOR CENTRAL DE REGRAS, CONFIGURAÇÕES E POLÍTICAS (FASE 1.1.5.11)
// ==========================================

model ConfigurationDefinition {
  id               String   @id @default(uuid())
  key              String   @unique // e.g. "finance.transfer.minimum_balance"
  domain           String   // FINANCE, EVENTS, REFUNDS, SAC, MARKETING, SECURITY, etc.
  name             String
  description      String?
  type             String   // BOOLEAN, INTEGER, DECIMAL, STRING, ENUM, DURATION, PERCENTAGE, CURRENCY, JSON_SCHEMA, REFERENCE
  unit             String?  // BRL, MINUTES, HOURS, DAYS, %
  defaultValue     String   // stringified or JSON
  allowedValues    String?  // JSON array
  validationSchema String?  // JSON schema
  sensitivity      String   @default("INTERNAL") // PUBLIC, INTERNAL, SENSITIVE, SECRET_REFERENCE
  allowedScopes    String   @default("[\"GLOBAL\",\"PRODUCER\",\"EVENT\"]") // JSON array
  requiresApproval Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  values           ConfigurationValue[]

  @@index([domain])
  @@index([sensitivity])
}

model ConfigurationValue {
  id                String   @id @default(uuid())
  definitionId      String
  scopeType         String   // GLOBAL, PRODUCER, EVENT
  producerId        String?
  eventId           String?
  value             String   // JSON stringified value
  version           Int      @default(1)
  isActive          Boolean  @default(true)
  effectiveFrom     DateTime?
  effectiveUntil    DateTime?
  updatedByUserId   String?
  updatedByUserName String?
  changeReason      String?
  approvalRequestId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  definition        ConfigurationDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  versions          ConfigurationVersion[]

  @@index([definitionId])
  @@index([scopeType])
  @@index([producerId])
  @@index([eventId])
}

model ConfigurationVersion {
  id                String   @id @default(uuid())
  valueId           String
  versionNumber     Int
  previousValue     String?
  newValue          String
  scopeType         String
  producerId        String?
  eventId           String?
  changeReason      String
  changedByUserId   String
  changedByUserName String?
  approvedByUserId  String?
  approvalRequestId String?
  effectiveFrom     DateTime?
  effectiveUntil    DateTime?
  createdAt         DateTime @default(now())

  configValue       ConfigurationValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@index([valueId])
  @@index([versionNumber])
}

model Policy {
  id               String   @id @default(uuid())
  code             String   @unique // e.g. "POL-FIN-TRANSFER"
  name             String
  domain           String   // FINANCE, EVENTS, REFUNDS, SAC, etc.
  description      String?
  scopeType        String   // GLOBAL, PRODUCER, EVENT
  producerId       String?
  eventId          String?
  status           String   @default("ACTIVE") // DRAFT, IN_REVIEW, APPROVED, SCHEDULED, ACTIVE, SUPERSEDED, ARCHIVED
  currentVersion   Int      @default(1)
  priority         Int      @default(100)
  effectiveFrom    DateTime?
  effectiveUntil   DateTime?
  requiresApproval Boolean  @default(false)
  createdBy        String
  creatorName      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rules            PolicyRule[]
  versions         PolicyVersion[]

  @@index([domain])
  @@index([scopeType])
  @@index([producerId])
  @@index([eventId])
  @@index([status])
}

model PolicyVersion {
  id             String   @id @default(uuid())
  policyId       String
  versionNumber  Int
  status         String
  rulesSnapshot  String   // JSON stringified rules
  changeReason   String
  createdBy      String
  creatorName    String?
  approvedBy     String?
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  createdAt      DateTime @default(now())

  policy         Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([versionNumber])
}

model PolicyRule {
  id            String   @id @default(uuid())
  policyId      String
  version       Int      @default(1)
  name          String
  description   String?
  priority      Int      @default(10)
  conditionJson String   // JSON array of conditions
  actionJson    String   // JSON object of action
  orderIndex    Int      @default(1)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  policy        Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([version])
  @@index([priority])
}

model PolicyConflict {
  id               String    @id @default(uuid())
  policyAId        String
  policyBId        String
  domain           String
  conflictType     String    // OVERLAPPING_CONDITIONS, AMBIGUOUS_PRIORITY, CONFLICTING_ACTIONS
  description      String
  status           String    @default("DETECTED") // DETECTED, REVIEWED, RESOLVED, IGNORED
  detectedAt       DateTime  @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolutionNotes  String?

  @@index([domain])
  @@index([status])
}

model FeatureFlag {
  id                    String    @id @default(uuid())
  key                   String    @unique // e.g. "feature.new_reconciliation"
  name                  String
  description           String?
  isEnabled             Boolean   @default(false)
  rolloutPercentage     Int       @default(0) // 0 to 100
  allowedRoles          String?   // JSON array
  allowedProducers      String?   // JSON array
  allowedEvents         String?   // JSON array
  isKillSwitch          Boolean   @default(false)
  killSwitchTriggeredAt DateTime?
  killSwitchTriggeredBy String?
  killSwitchReason      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([key])
  @@index([isEnabled])
  @@index([isKillSwitch])
}

model ConfigurationAudit {
  id            String   @id @default(uuid())
  entityType    String   // CONFIGURATION, POLICY, FEATURE_FLAG, KILL_SWITCH
  entityId      String
  entityKey     String?
  action        String   // CREATE, UPDATE, ACTIVATE, SCHEDULE, ROLLBACK, OVERRIDE, REMOVE_OVERRIDE, KILL_SWITCH_TRIGGER, KILL_SWITCH_RESET
  scopeType     String
  producerId    String?
  eventId       String?
  previousValue String?
  newValue      String?
  changeReason  String?
  userId        String
  userName      String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
}

model PolicyEvaluation {
  id                String   @id @default(uuid())
  operation         String
  domain            String
  producerId        String?
  eventId           String?
  inputJson         String
  decisionJson      String
  effectiveSource   String   // EVENT, PRODUCER, GLOBAL, DEFAULT
  policyId          String?
  policyVersion     Int?
  ruleId            String?
  isSimulated       Boolean  @default(false)
  evaluatedByUserId String
  createdAt         DateTime @default(now())

  @@index([domain])
  @@index([operation])
  @@index([effectiveSource])
  @@index([createdAt])
}

// ============================================================================
// 15. AUDITORIA, OBSERVABILIDADE E RASTREABILIDADE OPERACIONAL (FASE 1.1.5.12)
// ============================================================================

model IntegrationInbox {
  id              String    @id @default(uuid())
  source          String    // Gateway, Banco, Meta Ads, TikTok Ads, WhatsApp, etc.
  externalEventId String    @unique
  eventType       String
  correlationId   String?
  signatureValid  Boolean   @default(true)
  isIdempotent    Boolean   @default(true)
  payload         String    // JSON stringified payload
  status          String    @default("PROCESSED") // RECEIVED, PROCESSING, PROCESSED, FAILED
  processedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime  @default(now())

  @@index([source])
  @@index([eventType])
  @@index([status])
  @@index([correlationId])
  @@index([createdAt])
}

model BusinessEvent {
  id            String   @id @default(uuid())
  eventType     String   // ORDER_CREATED, ORDER_PAID, TICKET_ISSUED, REFUND_REQUESTED, FINANCE_TRANSFER_CREATED, TASK_CREATED, DOCUMENT_UPLOADED, INTEGRATION_FAILED, etc.
  correlationId String
  requestId     String?
  sourceService String
  producerId    String?
  eventId       String?
  resourceType  String?
  resourceId    String?
  payload       String   // JSON stringified payload
  consumers     String   // JSON stringified consumers array
  createdAt     DateTime @default(now())

  @@index([eventType])
  @@index([correlationId])
  @@index([sourceService])
  @@index([producerId])
  @@index([eventId])
  @@index([createdAt])
}

model OperationTrace {
  id                String      @id @default(uuid())
  correlationId     String      @unique // e.g. "COR-20260919-8F72A1"
  operationName     String      // e.g. "Venda de Ingressos #984521", "Transferência Bancária #TRF-8821"
  rootResourceType  String?
  rootResourceId    String?
  userId            String?
  userName          String?
  producerId        String?
  eventId           String?
  status            String      @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, FAILED, CANCELLED
  startedAt         DateTime    @default(now())
  endedAt           DateTime?
  durationMs        Int?
  policyKey         String?
  policyVersion     Int?
  policyDecision    String?     // JSON snapshot of decision
  policyExplanation String?
  approvalRequestId String?
  taskId            String?
  errorMessage      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  spans             TraceSpan[]

  @@index([correlationId])
  @@index([operationName])
  @@index([rootResourceType, rootResourceId])
  @@index([userId])
  @@index([producerId])
  @@index([eventId])
  @@index([status])
  @@index([startedAt])
}

model TraceSpan {
  id            String         @id @default(uuid())
  traceId       String
  correlationId String
  spanId        String         // e.g. "SPAN-001"
  parentSpanId  String?
  serviceName   String         // PaymentService, BankAdapter, PolicyEngine, ApprovalService, Prisma, etc.
  operation     String         // authenticate, policyEngine, approvalService, prisma.transaction, etc.
  status        String         @default("SUCCESS") // SUCCESS, ERROR, WARNING
  startedAt     DateTime       @default(now())
  endedAt       DateTime?
  durationMs    Int?
  metadata      String?        // JSON stringified metadata
  errorMessage  String?
  errorCode     String?

  trace         OperationTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@index([traceId])
  @@index([correlationId])
  @@index([serviceName])
  @@index([status])
  @@index([startedAt])
}

model ErrorGroup {
  id                  String            @id @default(uuid())
  fingerprint         String            @unique // SHA256(errorCode + service + operation)
  errorCode           String            // INTEGRATION_TIMEOUT, BANK_TIMEOUT, AUTH_PERMISSION_DENIED, etc.
  title               String
  service             String
  operation           String
  severity            String            @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  status              String            @default("UNRESOLVED") // UNRESOLVED, INVESTIGATING, RESOLVED, IGNORED
  firstSeenAt         DateTime          @default(now())
  lastSeenAt          DateTime          @default(now())
  occurrencesCount    Int               @default(1)
  affectedEventsCount Int               @default(0)
  affectedUsersCount  Int               @default(0)
  relatedTaskId       String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  occurrences         ErrorOccurrence[]

  @@index([errorCode])
  @@index([service])
  @@index([severity])
  @@index([status])
  @@index([lastSeenAt])
}

model ErrorOccurrence {
  id                  String     @id @default(uuid())
  errorGroupId        String
  correlationId       String?
  requestId           String?
  userId              String?
  producerId          String?
  eventId             String?
  errorMessage        String
  userFriendlyMessage String
  stackTrace          String?    // Restricted to technical detail permission
  contextData         String?    // JSON stringified context
  createdAt           DateTime   @default(now())

  errorGroup          ErrorGroup @relation(fields: [errorGroupId], references: [id], onDelete: Cascade)

  @@index([errorGroupId])
  @@index([correlationId])
  @@index([userId])
  @@index([producerId])
  @@index([eventId])
  @@index([createdAt])
}

model HealthCheck {
  id         String   @id @default(uuid())
  component  String   // API, POSTGRESQL, REDIS, WORKERS, WEBSOCKET, QUEUES, INTEGRATIONS
  status     String   @default("OPERATIONAL") // OPERATIONAL, DEGRADED, DOWN, MAINTENANCE
  latencyMs  Float?
  message    String?
  metadata   String?  // JSON stringified metadata
  checkedAt  DateTime @default(now())

  @@index([component])
  @@index([status])
  @@index([checkedAt])
}

model SystemAlert {
  id               String    @id @default(uuid())
  alertCode        String
  title            String
  severity         String    @default("WARNING") // INFO, WARNING, CRITICAL
  component        String
  occurrencesCount Int       @default(1)
  deduplicationKey String
  status           String    @default("ACTIVE") // ACTIVE, ACKNOWLEDGED, RESOLVED
  firstTriggeredAt DateTime  @default(now())
  lastTriggeredAt  DateTime  @default(now())
  resolvedAt       DateTime?
  resolvedBy       String?
  thresholdRule    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([alertCode])
  @@index([severity])
  @@index([component])
  @@index([status])
  @@index([deduplicationKey])
}

model MetricSnapshot {
  id         String   @id @default(uuid())
  metricName String
  value      Float
  unit       String?
  labels     String?  // JSON stringified labels
  timestamp  DateTime @default(now())

  @@index([metricName])
  @@index([timestamp])
}

model ObservabilityAnnotation {
  id            String   @id @default(uuid())
  correlationId String?
  category      String   // DEPLOYMENT, INCIDENT, CONFIG_CHANGE, MAINTENANCE
  title         String
  description   String?
  authorUserId  String
  createdAt     DateTime @default(now())

  @@index([correlationId])
  @@index([category])
  @@index([createdAt])
}

// ==============================================================================
// 16. MOTOR CENTRAL DE RELATÓRIOS, EXPORTAÇÕES E BI OPERACIONAL (FASE 1.1.5.13)
// ==============================================================================

model MetricDefinitionModel {
  id                  String    @id @default(uuid())
  code                String    @unique
  name                String
  description         String
  domain              String    // COMERCIAL, FINANCEIRO, EVENTOS, SAC, ESTORNO, CONTABILIDADE, MARKETING, REMARKETING
  format              String    // CURRENCY, NUMBER, PERCENTAGE, DURATION, RATING
  formula             String
  source              String
  updateFrequency     String    // REAL_TIME, NEAR_REAL_TIME, PERIODIC, DAILY_CLOSE, SNAPSHOT
  responsible         String
  version             Int       @default(1)
  effectiveFrom       DateTime?
  effectiveUntil      DateTime?
  requiredPermission  String?
  isSensitive         Boolean   @default(false)
  lineage             String?   // JSON stringified steps
  supportedDimensions String?   // JSON stringified dimensions array
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([code])
  @@index([domain])
  @@index([version])
}

model SavedReportModel {
