// ==============================================================================
// DISK INTERNO - PRISMA ORM SCHEMA (PostgreSQL)
// Fase 1.1.5.1: Core Node.js Real - Autenticacao + RBAC + Escopo Produtor/Evento
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}

enum ScopeType {
  GLOBAL
  PRODUCER
  EVENT
}

// ------------------------------------------------------------------------------
// 1. USUÁRIO E IDENTIDADE
// ------------------------------------------------------------------------------

model User {
  id                String               @id @default(uuid())
  name              String
  email             String               @unique
  passwordHash      String
  status            UserStatus           @default(ACTIVE)
  isSuperAdmin      Boolean              @default(false)
  twoFactorEnabled  Boolean              @default(false)
  twoFactorSecret   String?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  // Relações do Core de Identidade
  userRoles         UserRole[]
  userPermissions   UserPermission[]
  producerAccesses  UserProducerAccess[]
  eventAccesses     UserEventAccess[]
  sessions          Session[]
  auditLogs         AuditLog[]
  notifications     NotificationRecipient[]
  preferences       NotificationPreference[]

  @@index([email])
  @@index([status])
}

// ------------------------------------------------------------------------------
// 2. PERFIS (ROLES)
// ------------------------------------------------------------------------------

model Role {
  id              String           @id @default(uuid())
  name            String
  code            String           @unique // Ex: ADMINISTRADOR_GERAL, FINANCEIRO
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([code])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ------------------------------------------------------------------------------
// 3. PERMISSÕES GRANULARES (PERMISSION ENGINE)
// ------------------------------------------------------------------------------

model Permission {
  id              String           @id @default(uuid())
  module          String           // Ex: financeiro, eventos, sac
  resource        String           // Ex: transferencia, saldo, pedido
  action          String           // Ex: visualizar, criar, aprovar
  code            String           @unique // Ex: financeiro.transferencia.aprovar
  description     String?
  createdAt       DateTime         @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([code])
  @@index([module])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  isGranted    Boolean    @default(true) // true = concessão direta, false = revogação explícita
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
}

// ------------------------------------------------------------------------------
// 4. ESCOPO DE DADOS: PRODUTOR & EVENTO
// ------------------------------------------------------------------------------

model Producer {
  id             String               @id @default(uuid())
  name           String
  cnpj           String               @unique
  email          String?
  phone          String?
  status         String               @default("ACTIVE")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  events         Event[]
  userAccesses   UserProducerAccess[]

  @@index([cnpj])
}

model Event {
  id                         String            @id @default(uuid())
  publicCode                 String            @unique
  producerId                 String

  name                       String
  title                      String?           // For backwards compatibility
  slug                       String?
  description                String?

  status                     String            @default("DRAFT")

  categoryId                 String?
  subcategoryId              String?
  format                     String?           @default("IN_PERSON") // IN_PERSON, ONLINE, HYBRID
  ageRating                  String?           @default("Livre")
  ageRatingDescription       String?

  startAt                    DateTime?
  endAt                      DateTime?
  eventDate                  DateTime?         // Backwards compatibility
  timezone                   String            @default("America/Sao_Paulo")
  hasMultipleSessions        Boolean           @default(false)

  venue                      String?
  address                    String?
  addressNumber              String?
  complement                 String?
  neighborhood               String?
  zipCode                    String?
  city                       String?
  state                      String?
  country                    String            @default("BR")

  onlinePlatform             String?
  onlineUrl                  String?
  onlineInstructions         String?

  capacity                   Int?
  estimatedCapacity          Int?
  soldTickets                Int?              @default(0)

  currency                   String            @default("BRL")
  locale                     String            @default("pt-BR")
  visibility                 String            @default("PRIVATE") // PRIVATE, UNLISTED, PUBLIC
  allowSearchIndexing        Boolean           @default(false)

  publicOrganizerName        String?
  operationalContact         String?
  operationalEmail           String?
  internalResponsibleUserId  String?

  coverDocumentId            String?

  version                    Int               @default(1)

  createdBy                  String?
  createdAt                  DateTime          @default(now())

  updatedBy                  String?
  updatedAt                  DateTime          @updatedAt

  archivedAt                 DateTime?
  deletedAt                  DateTime?
  deletedBy                  String?

  producer                   Producer          @relation(fields: [producerId], references: [id], onDelete: Restrict)
  userAccesses               UserEventAccess[]
  media                      EventMedia[]
  responsibilities           EventResponsibility[]
  wizardState                EventWizardState?
  eventVenues                EventVenue[]
  eventSections              EventSection[]
  sessions                   EventSession[]
  ticketTypes                EventTicketType[]
  batches                    TicketBatch[]
  salesRules                 SalesRule[]

  @@index([producerId])
  @@index([producerId, status])
  @@index([startAt])
  @@index([name])
}

model EventCategory {
  id        String          @id @default(uuid())
  name      String
  slug      String          @unique
  parentId  String?
  active    Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  parent        EventCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  subcategories EventCategory[] @relation("CategoryHierarchy")

  @@index([parentId])
  @@index([slug])
}

model EventMedia {
  id         String   @id @default(uuid())
  eventId    String
  documentId String
  type       String   // MAIN, COVER, SHARE, GALLERY
  sortOrder  Int      @default(0)
  caption    String?
  createdAt  DateTime @default(now())

  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([documentId])
}

model EventResponsibility {
  id                 String   @id @default(uuid())
  eventId            String
  responsibilityType String   // PRIMARY, OPERATIONS, COMMERCIAL, FINANCE, MARKETING, SUPPORT
  userId             String?
  teamId             String?
  notes              String?
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
}

model EventWizardState {
  id              String   @id @default(uuid())
  eventId         String   @unique
  currentStep     Int      @default(1)
  completedSteps  String   @default("[]") // JSON stringified array of step numbers
  lastVisitedStep Int      @default(1)
  stepStatuses    String?  @default("{}") // JSON stringified map
  updatedBy       String?
  updatedAt       DateTime @updatedAt

  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ------------------------------------------------------------------------------
// 4.1 LOCAIS, MAPAS E ESTRUTURA FÍSICA (FASE 1.2.3)
// ------------------------------------------------------------------------------

model Venue {
  id                String             @id @default(uuid())
  publicCode        String             @unique
  name              String
  type              String             // ARENA, STADIUM, THEATER, CONCERT_HALL, CONVENTION_CENTER, CLUB, BAR_RESTAURANT, OPEN_AIR, RACETRACK, GYMNASIUM, OTHER
  scope             String             @default("GLOBAL") // GLOBAL, PRODUCER
  producerId        String?
  status            String             @default("ACTIVE") // ACTIVE, ARCHIVED, DRAFT
  postalCode        String?
  street            String?
  number            String?
  complement        String?
  district          String?
  city              String
  state             String
  country           String             @default("BR")
  latitude          Float?
  longitude         Float?
  capacity          Int?               // Capacidade de referência do local
  phone             String?
  email             String?
  website           String?
  notes             String?
  version           Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  deletedBy         String?

  sections          VenueSection[]
  maps              VenueMap[]
  accessPoints      VenueAccessPoint[]
  eventVenues       EventVenue[]
  sessions          EventSession[]

  @@index([name])
  @@index([city, state])
  @@index([scope, producerId])
}

model VenueSection {
  id                String             @id @default(uuid())
  venueId           String
  name              String
  code              String
  type              String             // GENERAL_ADMISSION, SEATED, TABLE, BOX, VIP, TECHNICAL, ACCESS_ONLY
  capacity          Int
  parentSectionId   String?
  active            Boolean            @default(true)
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  venue             Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  parentSection     VenueSection?      @relation("SectionHierarchy", fields: [parentSectionId], references: [id])
  childSections     VenueSection[]     @relation("SectionHierarchy")
  rows              VenueRow[]
  seats             VenueSeat[]
  eventSections     EventSection[]

  @@index([venueId])
  @@index([parentSectionId])
}

model VenueMap {
  id                String             @id @default(uuid())
  venueId           String
  name              String
  description       String?
  activeVersionId   String?
  status            String             @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  venue             Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  versions          VenueMapVersion[]

  @@index([venueId])
}

model VenueMapVersion {
  id                   String             @id @default(uuid())
  mapId                String
  versionNumber        Int
  name                 String
  status               String             @default("DRAFT") // DRAFT, ACTIVE, ARCHIVED
  backgroundDocumentId String?
  svgData              String?
  scale                Float?             @default(1.0)
  width                Float?
  height               Float?
  version              Int                @default(1)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  map                  VenueMap           @relation(fields: [mapId], references: [id], onDelete: Cascade)
  elements             VenueMapElement[]
  rows                 VenueRow[]
  seats                VenueSeat[]
  eventVenues          EventVenue[]
  sessions             EventSession[]

  @@index([mapId])
  @@index([mapId, versionNumber])
}

model VenueMapElement {
  id                String             @id @default(uuid())
  mapVersionId      String
  type              String             // SECTION, ROW, SEAT, TABLE, STAGE, ENTRANCE, EXIT, TEXT, SHAPE, RESTROOM, BAR, OBSTACLE
  x                 Float
  y                 Float
  width             Float
  height            Float
  rotation          Float              @default(0)
  geometry          String?            // JSON stringified geometry data
  linkedSectionId   String?
  label             String?
  metadata          String?            // JSON stringified metadata
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())

  mapVersion        VenueMapVersion    @relation(fields: [mapVersionId], references: [id], onDelete: Cascade)

  @@index([mapVersionId])
  @@index([linkedSectionId])
}

model VenueRow {
  id                String             @id @default(uuid())
  sectionId         String
  mapVersionId      String
  code              String
  name              String
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())

  section           VenueSection       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  mapVersion        VenueMapVersion    @relation(fields: [mapVersionId], references: [id], onDelete: Cascade)
  seats             VenueSeat[]

  @@index([sectionId])
  @@index([mapVersionId])
}

model VenueSeat {
  id                String             @id @default(uuid())
  rowId             String?
  sectionId         String
  mapVersionId      String
  code              String
  label             String
  x                 Float?
  y                 Float?
  seatType          String             @default("STANDARD") // STANDARD, VIP, BOX, TABLE_SEAT
  accessible        Boolean            @default(false)
  companionSeat     Boolean            @default(false)
  restrictedView    Boolean            @default(false)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())

  row               VenueRow?          @relation(fields: [rowId], references: [id], onDelete: Cascade)
  section           VenueSection       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  mapVersion        VenueMapVersion    @relation(fields: [mapVersionId], references: [id], onDelete: Cascade)

  @@index([rowId])
  @@index([sectionId])
  @@index([mapVersionId])
}

model VenueAccessPoint {
  id                String             @id @default(uuid())
  venueId           String
  name              String
  code              String
  type              String             // MAIN_ENTRANCE, GATE, VIP_GATE, CREDENTIALS, STAFF, EMERGENCY_EXIT
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())

  venue             Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model EventVenue {
  id                    String             @id @default(uuid())
  eventId               String
  venueId               String
  venueMapId            String?
  venueMapVersionId     String?
  configurationSnapshot String?            // JSON snapshot of venue & map when linked
  createdAt             DateTime           @default(now())

  event                 Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue                 Venue              @relation(fields: [venueId], references: [id], onDelete: Restrict)
  mapVersion            VenueMapVersion?   @relation(fields: [venueMapVersionId], references: [id], onDelete: SetNull)

  @@unique([eventId, venueId])
  @@index([eventId])
  @@index([venueId])
}

model EventSection {
  id                   String             @id @default(uuid())
  eventId              String
  venueSectionId       String
  name                 String             // Custom event name (e.g. "Arquibancada Ouro")
  capacity             Int                // Capacity used by this event
  technicalReservation Int                @default(0)
  enabled              Boolean            @default(true)
  configuration        String?            // JSON configuration
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  event                Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venueSection         VenueSection       @relation(fields: [venueSectionId], references: [id], onDelete: Restrict)
  sessionSections      SessionSection[]
  ticketTypeSections   EventTicketTypeSection[]
  inventoryPools       InventoryPool[]
  priceConfigurations  PriceConfiguration[]

  @@unique([eventId, venueSectionId])
  @@index([eventId])
  @@index([venueSectionId])
}

// ------------------------------------------------------------------------------
// 4.2 DATAS, SESSÕES E CAPACIDADE OPERACIONAL (FASE 1.2.4)
// ------------------------------------------------------------------------------

model EventSession {
  id                   String                       @id @default(uuid())
  eventId              String
  publicCode           String                       @unique
  name                 String?
  doorsOpenAt          DateTime?
  startAt              DateTime
  endAt                DateTime?
  timezone             String                       @default("America/Sao_Paulo")
  venueId              String?
  venueMapVersionId    String?
  status               String                       @default("CONFIGURED") // DRAFT, CONFIGURED, SCHEDULED, OPEN, IN_PROGRESS, FINISHED, CANCELLED, ARCHIVED
  capacity             Int
  reservedCapacity     Int                          @default(0)
  isPrimary            Boolean                      @default(false)
  recurrenceGroupId    String?
  version              Int                          @default(1)
  createdBy            String?
  createdAt            DateTime                     @default(now())
  updatedBy            String?
  updatedAt            DateTime                     @updatedAt
  archivedAt           DateTime?

  event                Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue                Venue?                       @relation(fields: [venueId], references: [id], onDelete: SetNull)
  mapVersion           VenueMapVersion?             @relation(fields: [venueMapVersionId], references: [id], onDelete: SetNull)
  sessionSections      SessionSection[]
  reservations         SessionCapacityReservation[]
  ticketTypeSessions   EventTicketTypeSession[]
  inventoryPools       InventoryPool[]

  @@index([eventId])
  @@index([startAt])
  @@index([status])
  @@index([recurrenceGroupId])
}

model SessionSection {
  id                   String                       @id @default(uuid())
  sessionId            String
  eventSectionId       String
  enabled              Boolean                      @default(true)
  capacity             Int
  reservedCapacity     Int                          @default(0)
  configuration        String?                      // JSON
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  session              EventSession                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventSection         EventSection                 @relation(fields: [eventSectionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, eventSectionId])
  @@index([sessionId])
  @@index([eventSectionId])
}

model SessionCapacityReservation {
  id                   String                       @id @default(uuid())
  sessionId            String
  sectionId            String?
  type                 String                       // PRODUCTION, SECURITY, SPONSOR, ARTIST, ACCESSIBILITY, TECHNICAL, OTHER
  quantity             Int
  reason               String?
  createdAt            DateTime                     @default(now())

  session              EventSession                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sectionId])
}

model SessionRecurrenceGroup {
  id                   String                       @id @default(uuid())
  eventId              String
  rule                 String                       // JSON rule definition
  totalSessions        Int
  createdAt            DateTime                     @default(now())

  @@index([eventId])
}

// ==============================================================================
// 4.3 SETORES, TIPOS DE INGRESSO E INVENTÁRIO (FASE 1.2.5)
// 4.4 LOTES, PREÇOS, TAXAS E REGRAS DE VENDA (FASE 1.2.6)
// ==============================================================================

model TicketType {
  id                     String            @id @default(uuid())
  code                   String            @unique
  name                   String
  category               String            // INTEIRA, MEIA, SOCIAL, VIP, CORTESIA, COMBO, PROMOTIONAL, OTHER
  defaultDescription     String?
  halfPriceLawCompliance Boolean           @default(false)
  requiresDocument       Boolean           @default(false)
  documentType           String?
  requiresCode           Boolean           @default(false)
  requiresBenefit        Boolean           @default(false)
  benefitDescription     String?
  isSystem               Boolean           @default(true)
  active                 Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model EventTicketType {
  id                     String            @id @default(uuid())
  eventId                String
  ticketTypeId           String?
  name                   String
  code                   String
  category               String            // INTEIRA, MEIA, SOCIAL, VIP, CORTESIA, COMBO, PROMOTIONAL, OTHER
  description            String?
  halfPriceLawCompliance Boolean           @default(false)
  requiresDocument       Boolean           @default(false)
  documentType           String?
  requiresCode           Boolean           @default(false)
  requiresBenefit        Boolean           @default(false)
  benefitDescription     String?
  active                 Boolean           @default(true)
  sortOrder              Int               @default(0)
  minPerOrder            Int               @default(1)
  maxPerOrder            Int               @default(6)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  event                  Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sections               EventTicketTypeSection[]
  sessions               EventTicketTypeSession[]
  benefits               EventTicketTypeBenefit[]
  priceConfigurations    PriceConfiguration[]
  allocations            InventoryAllocation[]

  @@unique([eventId, code])
  @@index([eventId])
}

model EventTicketTypeSection {
  id                 String          @id @default(uuid())
  eventTicketTypeId  String
  eventSectionId     String

  eventTicketType    EventTicketType @relation(fields: [eventTicketTypeId], references: [id], onDelete: Cascade)
  eventSection       EventSection    @relation(fields: [eventSectionId], references: [id], onDelete: Cascade)

  @@unique([eventTicketTypeId, eventSectionId])
  @@index([eventTicketTypeId])
  @@index([eventSectionId])
}

model EventTicketTypeSession {
  id                 String          @id @default(uuid())
  eventTicketTypeId  String
  sessionId          String

  eventTicketType    EventTicketType @relation(fields: [eventTicketTypeId], references: [id], onDelete: Cascade)
  session            EventSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([eventTicketTypeId, sessionId])
  @@index([eventTicketTypeId])
  @@index([sessionId])
}

model EventTicketTypeBenefit {
  id                 String          @id @default(uuid())
  eventTicketTypeId  String
  name               String
  description        String?
  createdAt          DateTime        @default(now())

  eventTicketType    EventTicketType @relation(fields: [eventTicketTypeId], references: [id], onDelete: Cascade)

  @@index([eventTicketTypeId])
}

model InventoryPool {
  id             String                @id @default(uuid())
  sessionId      String
  eventSectionId String
  capacity       Int
  reserved       Int                   @default(0)
  blocked        Int                   @default(0)
  held           Int                   @default(0)
  sold           Int                   @default(0)
  version        Int                   @default(1)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  session        EventSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventSection   EventSection          @relation(fields: [eventSectionId], references: [id], onDelete: Cascade)
  allocations    InventoryAllocation[]
  blocks         InventoryBlock[]
  seatInventories SeatInventory[]

  @@unique([sessionId, eventSectionId])
  @@index([sessionId])
  @@index([eventSectionId])
}

model InventoryAllocation {
  id                String          @id @default(uuid())
  inventoryPoolId   String
  eventTicketTypeId String
  allocationType    String          // UNLIMITED, FIXED, PERCENTAGE
  allocationValue   Float
  allocatedQuantity Int
  soldQuantity      Int             @default(0)
  heldQuantity      Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  inventoryPool     InventoryPool   @relation(fields: [inventoryPoolId], references: [id], onDelete: Cascade)
  eventTicketType   EventTicketType @relation(fields: [eventTicketTypeId], references: [id], onDelete: Cascade)

  @@unique([inventoryPoolId, eventTicketTypeId])
  @@index([inventoryPoolId])
}

model InventoryBlock {
  id              String        @id @default(uuid())
  inventoryPoolId String
  reason          String        // TECHNICAL_HOLD, SPONSOR_HOLD, SECURITY_BUFFER, PRODUCER_HOLD, GOVERNMENT_HOLD, OTHER
  quantity        Int
  notes           String?
  active          Boolean       @default(true)
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  inventoryPool   InventoryPool @relation(fields: [inventoryPoolId], references: [id], onDelete: Cascade)

  @@index([inventoryPoolId])
}

model SeatInventory {
  id              String        @id @default(uuid())
  inventoryPoolId String
  venueSeatId     String?
  seatCode        String
  rowCode         String?
  status          String        @default("AVAILABLE") // AVAILABLE, HELD, RESERVED, SOLD, BLOCKED
  heldUntil       DateTime?
  orderId         String?
  ticketTypeId    String?
  version         Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  inventoryPool   InventoryPool @relation(fields: [inventoryPoolId], references: [id], onDelete: Cascade)

  @@unique([inventoryPoolId, seatCode])
  @@index([inventoryPoolId])
  @@index([status])
}

model TicketBatch {
  id                 String               @id @default(uuid())
  eventId            String
  name               String
  code               String
  phase              Int                  @default(1)
  status             String               @default("DRAFT") // DRAFT, SCHEDULED, ACTIVE, PAUSED, SOLD_OUT, ENDED, ARCHIVED
  activationType     String               @default("MANUAL") // MANUAL, DATE_TIME, PREVIOUS_BATCH_SOLD_OUT, PREVIOUS_BATCH_QUANTITY
  activationDate     DateTime?
  deactivationDate   DateTime?
  previousBatchId    String?
  triggerQuantity    Int?
  totalQuantityLimit Int?
  soldCount          Int                  @default(0)
  heldCount          Int                  @default(0)
  version            Int                  @default(1)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  event              Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  priceConfigurations PriceConfiguration[]

  @@unique([eventId, code])
  @@index([eventId])
  @@index([status])
}

model PriceConfiguration {
  id                 String          @id @default(uuid())
  ticketBatchId      String
  eventSectionId     String
  eventTicketTypeId  String
  basePriceInCents   Int
  salePriceInCents   Int
  minPriceInCents    Int?
  maxPriceInCents    Int?
  active             Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  ticketBatch        TicketBatch     @relation(fields: [ticketBatchId], references: [id], onDelete: Cascade)
  eventSection       EventSection    @relation(fields: [eventSectionId], references: [id], onDelete: Cascade)
  eventTicketType    EventTicketType @relation(fields: [eventTicketTypeId], references: [id], onDelete: Cascade)
  feeComponents      FeeComponent[]

  @@unique([ticketBatchId, eventSectionId, eventTicketTypeId])
  @@index([ticketBatchId])
  @@index([eventSectionId])
  @@index([eventTicketTypeId])
}

model FeeComponent {
  id                      String             @id @default(uuid())
  priceConfigurationId    String
  name                    String
  type                    String             // PERCENTAGE, FIXED
  value                   Float
  payer                   String             @default("BUYER") // BUYER, PRODUCER, SPLIT
  producerSharePercentage Float?
  minFeeInCents           Int?
  maxFeeInCents           Int?
  taxDeductible           Boolean            @default(false)
  createdAt               DateTime           @default(now())

  priceConfiguration      PriceConfiguration @relation(fields: [priceConfigurationId], references: [id], onDelete: Cascade)

  @@index([priceConfigurationId])
}

model SalesRule {
  id          String   @id @default(uuid())
  eventId     String
  type        String   // MAX_PER_ORDER, MIN_PER_ORDER, MAX_PER_CUSTOMER, SALES_WINDOW, REQUIRES_CODE, REQUIRES_DOCUMENT, HALF_PRICE_LIMIT
  scope       String   // EVENT, SESSION, BATCH, TICKET_TYPE
  scopeId     String?
  name        String
  description String?
  ruleConfig  String   // JSON string
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([scope])
}

// ==============================================================================
// 4.5 CANAIS DE VENDA, CORTESIAS & EQUIPE DO EVENTO (FASE 1.2.7)
// ==============================================================================

model SalesChannel {
  id            String              @id @default(uuid())
  code          String              @unique
  name          String
  type          String              // ONLINE, BOX_OFFICE, POS, INTERNAL, PARTNER, AFFILIATE, INVITATION, API
  scope         String              @default("GLOBAL") // GLOBAL, PRODUCER
  producerId    String?
  active        Boolean             @default(true)
  configuration String?             // JSON
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  eventChannels EventSalesChannel[]

  @@index([type])
  @@index([active])
}

model EventSalesChannel {
  id             String                      @id @default(uuid())
  eventId        String
  salesChannelId String
  enabled        Boolean                     @default(true)
  salesStartAt   DateTime?
  salesEndAt     DateTime?
  configuration  String?                     // JSON
  createdBy      String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  event          Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  salesChannel   SalesChannel                @relation(fields: [salesChannelId], references: [id], onDelete: Cascade)
  sessions       EventSalesChannelSession[]
  sections       EventSalesChannelSection[]
  ticketTypes    EventSalesChannelTicketType[]
  allocations    ChannelAllocation[]

  @@unique([eventId, salesChannelId])
  @@index([eventId])
  @@index([salesChannelId])
}

model EventSalesChannelSession {
  id                  String            @id @default(uuid())
  eventSalesChannelId String
  sessionId           String

  eventSalesChannel   EventSalesChannel @relation(fields: [eventSalesChannelId], references: [id], onDelete: Cascade)
  session             EventSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([eventSalesChannelId, sessionId])
  @@index([eventSalesChannelId])
  @@index([sessionId])
}

model EventSalesChannelSection {
  id                  String            @id @default(uuid())
  eventSalesChannelId String
  eventSectionId      String

  eventSalesChannel   EventSalesChannel @relation(fields: [eventSalesChannelId], references: [id], onDelete: Cascade)
  eventSection        EventSection      @relation(fields: [eventSectionId], references: [id], onDelete: Cascade)

  @@unique([eventSalesChannelId, eventSectionId])
  @@index([eventSalesChannelId])
  @@index([eventSectionId])
}

model EventSalesChannelTicketType {
  id                  String            @id @default(uuid())
  eventSalesChannelId String
  eventTicketTypeId   String

  eventSalesChannel   EventSalesChannel @relation(fields: [eventSalesChannelId], references: [id], onDelete: Cascade)
  eventTicketType     EventTicketType   @relation(fields: [eventTicketTypeId], references: [id], onDelete: Cascade)

  @@unique([eventSalesChannelId, eventTicketTypeId])
  @@index([eventSalesChannelId])
  @@index([eventTicketTypeId])
}

model ChannelAllocation {
  id                  String            @id @default(uuid())
  eventSalesChannelId String
  inventoryPoolId     String
  quantityLimit       Int
  quantityConsumed    Int               @default(0)
  startsAt            DateTime?
  endsAt              DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  eventSalesChannel   EventSalesChannel @relation(fields: [eventSalesChannelId], references: [id], onDelete: Cascade)
  inventoryPool       InventoryPool     @relation(fields: [inventoryPoolId], references: [id], onDelete: Cascade)

  @@unique([eventSalesChannelId, inventoryPoolId])
  @@index([eventSalesChannelId])
  @@index([inventoryPoolId])
}

model SalesPoint {
  id          String          @id @default(uuid())
  producerId  String?
  name        String
  type        String          // BOX_OFFICE, STORE, PARTNER_POS
  venueId     String?
  address     String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  venue       Venue?          @relation(fields: [venueId], references: [id], onDelete: SetNull)
  terminals   SalesTerminal[]

  @@index([producerId])
  @@index([venueId])
}

model SalesTerminal {
  id           String     @id @default(uuid())
  salesPointId String
  name         String
  code         String     @unique
  status       String     @default("ONLINE") // ONLINE, OFFLINE, MAINTENANCE
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  salesPoint   SalesPoint @relation(fields: [salesPointId], references: [id], onDelete: Cascade)

  @@index([salesPointId])
}

model SalesPartner {
  id         String   @id @default(uuid())
  producerId String?
  name       String
  document   String
  type       String   // AGENCY, PROMOTER, POS_PARTNER, SPONSOR, COMPANY
  status     String   @default("ACTIVE") // ACTIVE, INACTIVE, PENDING
  email      String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([producerId])
  @@index([document])
}

model ComplimentaryCategory {
  id          String   @id @default(uuid())
  eventId     String?
  code        String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([code, eventId])
  @@index([eventId])
}

model ComplimentaryQuota {
  id               String   @id @default(uuid())
  eventId          String
  sessionId        String?
  sectionId        String?
  quantityLimit    Int
  quantityUsed     Int      @default(0)
  quantityReserved Int      @default(0)
  policyId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([sessionId])
  @@index([sectionId])
}

model ComplimentaryRequest {
  id                String               @id @default(uuid())
  code              String               @unique
  eventId           String
  sessionId         String
  sectionId         String
  categoryId        String
  quantity          Int
  quantityIssued    Int                  @default(0)
  reason            String
  requesterId       String
  requesterName     String
  status            String               @default("SUBMITTED") // DRAFT, SUBMITTED, APPROVAL_PENDING, APPROVED, REJECTED, ISSUING, ISSUED, PARTIALLY_ISSUED, CANCELLED
  approvalRequestId String?
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  event             Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session           EventSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  section           EventSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  guests            ComplimentaryGuest[]

  @@index([eventId])
  @@index([sessionId])
  @@index([status])
}

model ComplimentaryGuest {
  id         String               @id @default(uuid())
  requestId  String
  name       String
  email      String?
  document   String?
  phone      String?
  notes      String?
  ticketId   String?
  issued     Boolean              @default(false)
  issuedAt   DateTime?
  createdAt  DateTime             @default(now())

  request    ComplimentaryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([document])
}

model EventTeam {
  id             String              @id @default(uuid())
  eventId        String
  name           String
  description    String?
  leaderMemberId String?
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members        EventTeamMember[]
  shifts         EventTeamShift[]

  @@index([eventId])
}

model EventTeamMember {
  id               String               @id @default(uuid())
  eventId          String
  teamId           String?
  userId           String?
  externalPersonId String?
  name             String
  email            String
  phone            String?
  roleName         String
  emergencyContact String?
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  event            Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team             EventTeam?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  shiftAssignments EventShiftAssignment[]

  @@index([eventId])
  @@index([teamId])
  @@index([userId])
}

model EventTeamShift {
  id          String                 @id @default(uuid())
  eventId     String
  teamId      String
  sessionId   String?
  name        String
  startAt     DateTime
  endAt       DateTime
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  team        EventTeam              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  session     EventSession?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  assignments EventShiftAssignment[]

  @@index([eventId])
  @@index([teamId])
  @@index([sessionId])
}

model EventShiftAssignment {
  id        String          @id @default(uuid())
  shiftId   String
  memberId  String
  createdAt DateTime        @default(now())

  shift     EventTeamShift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  member    EventTeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([shiftId, memberId])
  @@index([shiftId])
  @@index([memberId])
}

// ==============================================================================
// 4.6 DOCUMENTOS, PENDÊNCIAS & READINESS DO EVENTO (FASE 1.2.8)
// ==============================================================================

model EventDocumentRequirement {
  id              String    @id @default(uuid())
  eventId         String
  categoryCode    String
  categoryName    String
  required        Boolean   @default(true)
  blocking        Boolean   @default(true)
  validFrom       DateTime?
  validUntil      DateTime?
  status          String    @default("MISSING") // MISSING, UPLOADED, UNDER_REVIEW, VALID, REJECTED, EXPIRED, EXPIRING
  linkedDocumentId String?
  linkedDocumentName String?
  linkedDocumentUrl String?
  fileSize        String?
  rejectionReason String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([categoryCode])
  @@index([status])
}

model ReadinessCheckDefinition {
  id          String   @id @default(uuid())
  code        String   @unique
  category    String   // INFO, VENUE, SESSIONS, CAPACITY, INVENTORY, PRICING, CHANNELS, DOCUMENTS, TEAM
  name        String
  description String
  severity    String   // INFO, WARNING, BLOCKING, CRITICAL
  target      String   // REVIEW, PUBLICATION, SALES, OPERATION, CLOSURE
  actionCode  String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model ReadinessSnapshot {
  id             String   @id @default(uuid())
  eventId        String   @unique
  status         String   // READY, WARNING, BLOCKED, NOT_APPLICABLE, PENDING
  score          Int      @default(0)
  targetsJson    String   // JSON map of targets to statuses
  summaryJson    String   // JSON counts
  categoriesJson String   // JSON categories status
  issuesJson     String   // JSON array of issues
  evaluatedAt    DateTime @default(now())

  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
}

// ------------------------------------------------------------------------------
// FASE 1.2.9: REVISÃO, APROVAÇÃO E PUBLICAÇÃO
// ------------------------------------------------------------------------------

model EventReviewSnapshot {
  id                String   @id @default(uuid())
  eventId           String
  eventVersion      Int      @default(1)
  configurationHash String
  submittedBy       String
  submittedByName   String?
  submittedAt       DateTime @default(now())
  status            String   @default("VALID") // VALID, INVALIDATED, SUPERSEDED
  invalidatedReason String?
  summaryJson       String   // JSON com contagens e métricas na submissão
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([eventId])
  @@index([status])
}

model EventPublicationSchedule {
  id            String    @id @default(uuid())
  eventId       String
  scheduledAt   DateTime
  timezone      String    @default("America/Sao_Paulo")
  status        String    @default("PENDING") // PENDING, EXECUTED, CANCELLED, BLOCKED
  createdBy     String
  createdAt     DateTime  @default(now())
  executedAt    DateTime?
  failureReason String?

  @@index([eventId])
  @@index([status])
  @@index([scheduledAt])
}

// ------------------------------------------------------------------------------
// FASE 1.2.10: ALTERAÇÕES CONTROLADAS & ANÁLISE DE IMPACTO
// ------------------------------------------------------------------------------

model EventChangeRequest {
  id                    String    @id @default(uuid())
  publicCode            String    @unique // ALT-XXXXXX
  eventId               String
  sessionId             String?
  sessionName           String?
  resourceType          String
  resourceId            String
  changeType            String    // EVENT_DATE, EVENT_VENUE, SESSION_DATE, SESSION_STATUS, etc.
  classification        String    // NON_CRITICAL, REVIEW_INVALIDATING, PUBLICATION_CRITICAL, POST_SALES_CRITICAL
  status                String    @default("DRAFT") // DRAFT, ANALYZING, READY_FOR_SUBMISSION, APPROVAL_PENDING, etc.
  requestedBy           String
  requestedByName       String?
  requestedAt           DateTime  @default(now())
  reason                String
  businessJustification String?
  payloadJson           String    // JSON do campo alterado { field, before, after }
  impactJson            String?   // JSON com resultado da análise de impacto
  approvalRequestId     String?
  approvalStatus        String?
  rejectionReason       String?
  scheduledExecutionAt  DateTime?
  executedAt            DateTime?
  executedBy            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([eventId])
  @@index([status])
  @@index([publicCode])
}

// ------------------------------------------------------------------------------
// FASE 1.2.11: DASHBOARD EXECUTIVO & OPERACIONAL (SNAPSHOT CACHE)
// ------------------------------------------------------------------------------

model EventDashboardSnapshot {
  id            String    @id @default(uuid())
  eventId       String
  sessionId     String?
  snapshotType  String    @default("CONSOLIDATED")
  payloadJson   String    // JSON com dados pré-agregados do dashboard
  generatedAt   DateTime  @default(now())
  sourceVersion Int       @default(1)
  expiresAt     DateTime?

  @@index([eventId])
  @@index([sessionId])
}

model UserProducerAccess {
  id         String   @id @default(uuid())
  userId     String
  producerId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@unique([userId, producerId])
  @@index([userId])
  @@index([producerId])
}

model UserEventAccess {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

// ------------------------------------------------------------------------------
// 5. CONTROLE DE SESSÕES (JWT REFRESH)
// ------------------------------------------------------------------------------

model Session {
  id           String    @id @default(uuid())
  userId       String
  token        String    @unique
  refreshToken String?   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([refreshToken])
}

// ------------------------------------------------------------------------------
// 6. TRILHA DE AUDITORIA IMUTÁVEL
// ------------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  correlationId String?
  requestId     String?
  userId        String?
  userName      String?
  sessionId     String?
  module        String?  // FINANCE, EVENTS, SAC, REFUNDS, MARKETING, SECURITY, etc.
  action        String
  resource      String
  resourceType  String?
  resourceId    String?
  producerId    String?
  eventId       String?
  beforeData    String?  // JSON stringified
  afterData     String?  // JSON stringified
  details       String?
  ipAddress     String?
  ipHash        String?
  userAgent     String?
  result        String   @default("SUCCESS") // SUCCESS, DENIED, FAILED
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([correlationId])
  @@index([requestId])
  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([resource])
  @@index([producerId])
  @@index([eventId])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// 7. NOTIFICAÇÕES, OUTBOX & REAL-TIME (FASE 1.1.5.5)
// ------------------------------------------------------------------------------

model Notification {
  id           String    @id @default(uuid())
  type         String    // INFO, SUCCESS, WARNING, CRITICAL, ACTION_REQUIRED
  priority     String    @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  module       String    // FINANCE, EVENTS, SAC, REFUNDS, MARKETING, SECURITY, etc.
  title        String
  description  String
  groupKey     String?   // For anti-noise deduplication & grouping (e.g. sales:evt_1001)
  resourceType String?   // TRANSFER, ORDER, TICKET, INCIDENT, EVENT, etc.
  resourceId   String?
  actionUrl    String?   // e.g. /finance/transfers/trf_123
  producerId   String?
  eventId      String?
  metadata     String?   // JSON stringified extra payload
  createdAt    DateTime  @default(now())

  recipients   NotificationRecipient[]

  @@index([module])
  @@index([groupKey])
  @@index([createdAt])
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId String
  userId         String
  status         String       @default("UNREAD") // UNREAD, READ, ARCHIVED, DISMISSED
  readAt         DateTime?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, status])
}

model NotificationPreference {
  id             String   @id @default(uuid())
  userId         String
  module         String
  channel        String   @default("IN_APP") // IN_APP, EMAIL, WHATSAPP
  isEnabled      Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module, channel])
  @@index([userId])
}

model NotificationRule {
  id              String   @id @default(uuid())
  eventType       String   @unique // e.g. FINANCE_TRANSFER_CREATED
  requiredPerm    String?  // e.g. financeiro.transferencia.aprovar
  defaultPriority String   @default("NORMAL")
  type            String   @default("INFO")
  isMandatory     Boolean  @default(false) // If true, cannot be disabled by user preferences (e.g. security)
  createdAt       DateTime @default(now())
}

model EventOutbox {
  id            String    @id @default(uuid())
  eventId       String    @unique // Unique event ID for idempotency
  eventType     String
  correlationId String?
  producerId    String?
  eventIdRef    String?
  resourceType  String?
  resourceId    String?
  actorUserId   String?
  payload       String    // JSON stringified payload
  status        String    @default("PENDING") // PENDING, PROCESSED, FAILED
  retryCount    Int       @default(0)
  errorMessage  String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([status])
  @@index([correlationId])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// 8. CENTRAL DE CONSULTA & DOMÍNIOS OPERACIONAIS (FASE 1.1.5.6)
// ------------------------------------------------------------------------------

model Customer {
  id              String          @id @default(uuid())
  name            String
  cpf             String          @unique
  cpfNormalized   String          @unique
  email           String
  emailNormalized String
  phone           String
  phoneNormalized String
  city            String?
  state           String?
  totalOrders     Int             @default(0)
  totalSpent      Float           @default(0)
  createdAt       DateTime        @default(now())

  orders          Order[]
  supportTickets  SupportTicket[]
  refunds         Refund[]

  @@index([cpfNormalized])
  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([name])
}

model Order {
  id                    String          @id @default(uuid())
  orderNumber           String          @unique // e.g. PED-984521 or DK-98421
  orderNumberNormalized String          @unique
  producerId            String
  eventId               String
  eventName             String
  customerId            String
  customerName          String
  customerCpf           String
  itemsCount            Int             @default(1)
  grossAmount           Float
  serviceFee            Float           @default(0)
  totalAmount           Float
  status                String          @default("PAID") // PAID, PENDING, CANCELLED, REFUNDED
  paymentMethod         String          @default("PIX")  // PIX, CREDIT_CARD, BOLETO
  createdAt             DateTime        @default(now())

  customer              Customer        @relation(fields: [customerId], references: [id])
  producer              Producer        @relation(fields: [producerId], references: [id])
  event                 Event           @relation(fields: [eventId], references: [id])
  tickets               Ticket[]
  payments              Payment[]
  refunds               Refund[]
  supportTickets        SupportTicket[]

  @@index([orderNumberNormalized])
  @@index([producerId])
  @@index([eventId])
  @@index([customerId])
}

model Ticket {
  id                  String   @id @default(uuid())
  ticketCode          String   @unique // e.g. ING-88211 or TKT-98421-01
  ticketCodeNormalized String  @unique
  orderId             String
  eventId             String
  eventName           String
  producerId          String
  sectorName          String
  price               Float
  customerName        String
  customerCpf         String
  nominalAttendee     String
  status              String   @default("VALID") // VALID, USED, CANCELLED
  qrCode              String?
  checkInAt           DateTime?
  createdAt           DateTime @default(now())

  order               Order    @relation(fields: [orderId], references: [id])
  event               Event    @relation(fields: [eventId], references: [id])
  producer            Producer @relation(fields: [producerId], references: [id])

  @@index([ticketCodeNormalized])
  @@index([orderId])
  @@index([eventId])
  @@index([producerId])
}

model Payment {
  id                        String   @id @default(uuid())
  transactionCode           String   @unique // e.g. TRX-552811
  transactionCodeNormalized String   @unique
  orderId                   String
  eventId                   String
  producerId                String
  gateway                   String   @default("PIX_BancoCentral")
  method                    String   @default("PIX")
  amount                    Float
  netAmount                 Float
  status                    String   @default("APPROVED") // APPROVED, PENDING, REFUNDED
  isReconciled              Boolean  @default(true)
  createdAt                 DateTime @default(now())

  order                     Order    @relation(fields: [orderId], references: [id])
  event                     Event    @relation(fields: [eventId], references: [id])
  producer                  Producer @relation(fields: [producerId], references: [id])

  @@index([transactionCodeNormalized])
  @@index([orderId])
  @@index([producerId])
}

model Refund {
  id                   String    @id @default(uuid())
  refundCode           String    @unique // e.g. EST-882
  refundCodeNormalized String    @unique
  orderId              String
  customerId           String
  customerName         String
  eventId              String
  producerId           String
  amount               Float
  reason               String
  status               String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED
  approvedAt           DateTime?
  createdAt            DateTime  @default(now())

  order                Order     @relation(fields: [orderId], references: [id])
  customer             Customer  @relation(fields: [customerId], references: [id])
  event                Event     @relation(fields: [eventId], references: [id])
  producer             Producer  @relation(fields: [producerId], references: [id])

  @@index([refundCodeNormalized])
  @@index([orderId])
  @@index([producerId])
}

model SupportTicket {
  id                   String    @id @default(uuid())
  ticketCode           String    @unique // e.g. ATD-5521
  ticketCodeNormalized String    @unique
  customerId           String
  customerName         String
  orderId              String?
  eventId              String?
  producerId           String?
  channel              String    @default("WHATSAPP") // WHATSAPP, EMAIL, PHONE
  subject              String
  status               String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  priority             String    @default("NORMAL")
  agentName            String?
  slaMinutes           Int       @default(30)
  createdAt            DateTime  @default(now())

  customer             Customer  @relation(fields: [customerId], references: [id])
  order                Order?    @relation(fields: [orderId], references: [id])

  @@index([ticketCodeNormalized])
  @@index([customerId])
  @@index([orderId])
}

model MarketingCampaign {
  id                 String   @id @default(uuid())
  name               String
  nameNormalized     String
  platform           String   // META, GOOGLE, TIKTOK
  eventId            String
  eventName          String
  producerId         String
  status             String   @default("ACTIVE") // ACTIVE, PAUSED, ENDED
  spend              Float    @default(0)
  attributedRevenue  Float    @default(0)
  roas               Float    @default(0)
  cpa                Float    @default(0)
  createdAt          DateTime @default(now())

  event              Event    @relation(fields: [eventId], references: [id])
  producer           Producer @relation(fields: [producerId], references: [id])

  @@index([nameNormalized])
  @@index([eventId])
  @@index([producerId])
}

model SearchHistory {
  id         String   @id @default(uuid())
  userId     String
  query      String
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ------------------------------------------------------------------------------
// 9. MOTOR CENTRAL DE APROVAÇÕES, ALÇADAS E DUPLA VALIDAÇÃO (FASE 1.1.5.7)
// ------------------------------------------------------------------------------

model ApprovalRule {
  id                       String    @id @default(uuid())
  code                     String    @unique // e.g. RULE_FIN_TRANSFER_TIER_1
  name                     String
  description              String?
  operation                String    // FINANCE_TRANSFER, REFUND_REQUEST, ADMIN_PERMISSION_CHANGE, etc.
  producerId               String?   // null = GLOBAL
  eventId                  String?   // null = all events
  minAmount                Float?    @default(0)
  maxAmount                Float?
  approvalsRequired        Int       @default(1)
  isSequential             Boolean   @default(false)
  requireDistinctApprovers Boolean   @default(true)
  prohibitSelfApproval     Boolean   @default(true) // SOLICITANTE != APROVADOR
  requireStepUp            Boolean   @default(false)
  require2FA               Boolean   @default(false)
  requireComment           Boolean   @default(false)
  requiredDocuments        String?   // JSON array of required doc types
  slaMinutes               Int?      @default(120)
  escalationTimeoutMinutes Int?
  escalationRole           String?
  allowedRoles             String    // JSON array of role codes, e.g. ["FINANCEIRO", "ADMINISTRADOR_GERAL"]
  version                  Int       @default(1)
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  requests                 ApprovalRequest[]

  @@index([operation, isActive])
  @@index([producerId])
  @@index([eventId])
}

model ApprovalThreshold {
  id                 String   @id @default(uuid())
  userId             String?
  roleId             String?
  roleCode           String?
  operation          String   // FINANCE_TRANSFER, REFUND_REQUEST, etc.
  maxApprovalAmount  Float    // Upper bound amount authorized for this user/role
  producerId         String?  // Scope restriction
  eventId            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, operation])
  @@index([roleCode, operation])
}

model ApprovalRequest {
  id                 String    @id @default(uuid())
  requestCode        String    @unique // e.g. APR-1001
  operation          String    // FINANCE_TRANSFER, REFUND_REQUEST, etc.
  title              String
  description        String?
  resourceType       String    // FINANCE_TRANSFER, REFUND, USER_PERMISSION, EVENT
  resourceId         String
  amount             Float?
  producerId         String?
  eventId            String?
  requesterId        String
  requesterName      String
  requesterRole      String?
  ruleId             String
  ruleVersion        Int       @default(1)
  policySnapshot     String    // JSON snapshot of the rule at creation time (immutable)
  status             String    @default("PENDING") // DRAFT, PENDING, IN_REVIEW, CHANGES_REQUESTED, PARTIALLY_APPROVED, APPROVED, REJECTED, CANCELLED, EXECUTING, EXECUTED, FAILED
  approvalsCount     Int       @default(0)
  approvalsRequired  Int       @default(1)
  currentStep        Int       @default(1)
  executionKey       String?   @unique // Idempotency key
  executionResult    String?   // JSON result of executed action
  executedAt         DateTime?
  executionError     String?
  expiresAt          DateTime?
  isEscalated        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  rule               ApprovalRule         @relation(fields: [ruleId], references: [id])
  steps              ApprovalStep[]
  decisions          ApprovalDecision[]
  comments           ApprovalComment[]
  attachments        ApprovalAttachment[]

  @@index([status])
  @@index([requesterId])
  @@index([producerId])
  @@index([eventId])
  @@index([createdAt])
}

model ApprovalStep {
  id                 String    @id @default(uuid())
  requestId          String
  stepOrder          Int       @default(1)
  roleCode           String?
  groupId            String?
  status             String    @default("PENDING") // PENDING, APPROVED, REJECTED, SKIPPED
  approvedByUserId   String?
  approvedByUserName String?
  decision           String?   // APPROVED, REJECTED, CHANGES_REQUESTED
  comment            String?
  stepUpVerified     Boolean   @default(false)
  decidedAt          DateTime?
  createdAt          DateTime  @default(now())

  request            ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, stepOrder])
}

model ApprovalDecision {
  id                  String   @id @default(uuid())
  requestId           String
  userId              String
  userName            String
  userRole            String?
  decision            String   // APPROVED, REJECTED, CHANGES_REQUESTED, CANCELLED
  comment             String?
  reasonCategory      String?  // SALDO, DOCUMENTACAO, REGRA, OUTRO
  isDelegated         Boolean  @default(false)
  delegatedFromUserId String?
  stepUpToken         String?
  createdAt           DateTime @default(now())

  request             ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([userId])
}

model ApprovalDelegation {
  id                  String   @id @default(uuid())
  fromUserId          String
  fromUserName        String?
  toUserId            String
  toUserName          String?
  module              String?  // FINANCEIRO, ESTORNO, null = ALL
  startDate           DateTime
  endDate             DateTime
  status              String   @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  createdAt           DateTime @default(now())

  @@index([fromUserId, status])
  @@index([toUserId, status])
}

model ApprovalComment {
  id         String   @id @default(uuid())
  requestId  String
  userId     String
  userName   String
  comment    String
  createdAt  DateTime @default(now())

  request    ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model ApprovalAttachment {
  id                 String   @id @default(uuid())
  requestId          String
  documentType       String   // NOTA_FISCAL, COMPROVANTE, AUTORIZACAO, CONTRATO
  fileName           String
  fileUrl            String
  fileSize           Int?
  mimeType           String?
  uploadedByUserId   String
  uploadedByUserName String
  createdAt          DateTime @default(now())

  request            ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model ApprovalGroup {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  members     ApprovalGroupMember[]
}

model ApprovalGroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group     ApprovalGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

// ==========================================
// 10. CENTRAL DE ARQUIVOS, DOCUMENTOS E ANEXOS (FASE 1.1.5.8)
// ==========================================

model Document {
  id               String            @id @default(uuid())
  organizationId   String?           @default("org-disk-ingressos")
  producerId       String?
  eventId          String?
  title            String
  description      String?
  categoryId       String
  status           String            @default("AVAILABLE") // PROCESSING, AVAILABLE, REJECTED, QUARANTINED, EXPIRED, ARCHIVED, DELETED
  isConfidential   Boolean           @default(false)
  validFrom        DateTime?
  validUntil       DateTime?
  createdBy        String
  currentVersionId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  category         DocumentCategory  @relation(fields: [categoryId], references: [id])
  versions         DocumentVersion[]
  links            DocumentLink[]
  accessLogs       DocumentAccessLog[]
  tagLinks         DocumentTagLink[]

  @@index([status])
  @@index([producerId])
  @@index([eventId])
  @@index([categoryId])
  @@index([validUntil])
}

model DocumentVersion {
  id                String            @id @default(uuid())
  documentId        String
  version           Int               @default(1)
  storageKey        String
  originalFileName  String
  mimeType          String
  size              Int
  checksumAlgorithm String            @default("SHA-256")
  checksum          String
  changeReason      String?
  uploadedByUserId  String
  createdAt         DateTime          @default(now())

  document          Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  securityChecks    DocumentSecurityCheck[]
  accessLogs        DocumentAccessLog[]

  @@unique([documentId, version])
  @@index([documentId])
  @@index([storageKey])
}

model DocumentLink {
  id           String    @id @default(uuid())
  documentId   String
  resourceType String    // PRODUCER, EVENT, ORDER, TICKET, PAYMENT, TRANSFER, REFUND, SUPPORT_TICKET, SUPPLIER, CONTRACT, CAMPAIGN, APPROVAL_REQUEST
  resourceId   String
  producerId   String?
  eventId      String?
  createdAt    DateTime  @default(now())

  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([resourceType, resourceId])
  @@index([producerId])
  @@index([eventId])
}

model DocumentCategory {
  id               String            @id @default(uuid())
  code             String            @unique // CONTRATO, NOTA_FISCAL, COMPROVANTE, BOLETO, EXTRATO, AUTORIZACAO, DOCUMENTO_FISCAL, DOCUMENTO_CONTABIL, DOCUMENTO_BANCARIO, RELATORIO, EVIDENCIA, ANEXO_ATENDIMENTO, DOCUMENTO_EVENTO, CRIATIVO, OUTRO
  name             String
  description      String?
  retentionDays    Int?              // null = permanent / policy based
  isSensitive      Boolean           @default(false)
  allowedMimeTypes String?           // JSON array or comma separated
  maxSizeBytes     Int?              @default(52428800) // 50MB default
  createdAt        DateTime          @default(now())

  documents        Document[]
  retentionPolicies DocumentRetentionPolicy[]
}

model DocumentTag {
  id        String            @id @default(uuid())
  name      String            @unique
  createdAt DateTime          @default(now())

  tagLinks  DocumentTagLink[]
}

model DocumentTagLink {
  id         String      @id @default(uuid())
  documentId String
  tagId      String

  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        DocumentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([documentId, tagId])
  @@index([documentId])
  @@index([tagId])
}

model DocumentAccessLog {
  id         String           @id @default(uuid())
  documentId String
  versionId  String?
  userId     String
  userName   String?
  action     String           // VIEW, DOWNLOAD, PREVIEW, VERSION_CREATE, ARCHIVE, DELETE_REQUEST, DELETE, PERMISSION_DENIED, QUARANTINED, LINK_CREATE, LINK_DELETE
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime         @default(now())

  document   Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    DocumentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([userId])
  @@index([createdAt])
}

model DocumentSecurityCheck {
  id         String          @id @default(uuid())
  versionId  String
  status     String          // PASSED, QUARANTINED, REJECTED
  scanResult String?
  threatName String?
  scannedAt  DateTime        @default(now())

  version    DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([status])
}

model DocumentRetentionPolicy {
  id            String           @id @default(uuid())
  categoryId    String
  producerId    String?
  retentionDays Int
  action        String           @default("ARCHIVE") // ARCHIVE, PERMANENT_DELETE
  createdAt     DateTime         @default(now())

  category      DocumentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model DocumentRequirement {
  id                 String   @id @default(uuid())
  operation          String   // FINANCE_TRANSFER, REFUND_REQUEST, FINANCE_ADVANCE, FINANCE_PAYMENT, APPROVAL
  producerId         String?
  eventId            String?
  minAmount          Float?
  maxAmount          Float?
  requiredCategories String   // JSON array of category codes: '["NOTA_FISCAL", "AUTORIZACAO"]'
  createdAt          DateTime @default(now())

  @@index([operation])
  @@index([producerId])
  @@index([eventId])
}

// ============================================================================
// SEÇÃO 11: MOTOR CENTRAL DE TAREFAS, PENDÊNCIAS E FLUXOS (Fase 1.1.5.9)
// ============================================================================

model Task {
  id                    String    @id @default(uuid())
  taskNumber            String    @unique // e.g. TSK-8821
  title                 String
  description           String?
  module                String    // FINANCEIRO, SAC, EVENTOS, ESTORNO, CONTABILIDADE, MARKETING, COMERCIAL, OPERACOES, SEGURANCA, GERAL
  type                  String    // INVESTIGATE_DIVERGENCE, REVIEW_REFUND_DOCS, VALIDATE_INVOICE, etc.
  priority              String    @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  status                String    @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, WAITING, BLOCKED, COMPLETED, CANCELLED
  waitingReason         String?   // CLIENTE, PRODUTOR, FORNECEDOR, BANCO, GATEWAY, OUTRO_DEPARTAMENTO
  blockedReason         String?
  assignedUserId        String?
  assignedUserName      String?
  assignedTeamId        String?
  assignedTeamName      String?
  organizationId        String?
  producerId            String?
  producerName          String?
  eventId               String?
  eventName             String?
  resourceType          String?   // ORDER, CUSTOMER, EVENT, PAYMENT, TRANSFER, REFUND, SUPPORT_TICKET, CAMPAIGN, DOCUMENT
  resourceId            String?
  workflowId            String?
  workflowRuleId        String?
  templateId            String?
  slaPolicyId           String?
  dueAt                 DateTime?
  slaStartedAt          DateTime?
  slaPausedAt           DateTime?
  slaResumedAt          DateTime?
  slaDeadline           DateTime?
  slaStatus             String    @default("WITHIN_SLA") // WITHIN_SLA, NEARING_BREACH, BREACHED, PAUSED
  totalPausedDurationMs Int       @default(0)
  estimatedMinutes      Int?
  startedAt             DateTime?
  completedAt           DateTime?
  completedByUserId     String?
  cancelledAt           DateTime?
  cancelledByUserId     String?
  cancelReason          String?
  reopenedAt            DateTime?
  reopenedByUserId      String?
  reopenReason          String?
  escalationLevel       Int       @default(0)
  createdBy             String
  creatorName           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  assignments           TaskAssignment[]
  checklists            TaskChecklist[]
  checklistItems        TaskChecklistItem[]
  comments              TaskComment[]
  history               TaskHistory[]
  dependencies          TaskDependency[]      @relation("TaskDependencies")
  dependentOnMe         TaskDependency[]      @relation("TaskDependentOnMe")
  slaEvents             SlaEvent[]
  escalationEvents      EscalationEvent[]

  @@index([status])
  @@index([priority])
  @@index([module])
  @@index([assignedUserId])
  @@index([assignedTeamId])
  @@index([producerId])
  @@index([eventId])
  @@index([resourceType, resourceId])
  @@index([dueAt])
  @@index([slaStatus])
  @@index([createdAt])
}

model TaskAssignment {
  id               String   @id @default(uuid())
  taskId           String
  fromUserId       String?
  toUserId         String?
  fromTeamId       String?
  toTeamId         String?
  assignmentType   String   @default("MANUAL") // MANUAL, ROUTER_AUTO, ROUTER_ROUND_ROBIN, ROUTER_WORKLOAD, ROUTER_DUTY, CLAIMED
  reason           String?
  comment          String?
  assignedByUserId String?
  createdAt        DateTime @default(now())

  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([toUserId])
  @@index([toTeamId])
}

model TaskChecklist {
  id        String   @id @default(uuid())
  taskId    String
  title     String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskChecklistItem {
  id                String    @id @default(uuid())
  taskId            String
  text              String
  isRequired        Boolean   @default(false)
  isCompleted       Boolean   @default(false)
  completedByUserId String?
  completedAt       DateTime?
  orderIndex        Int       @default(0)

  task              Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskComment {
  id         String   @id @default(uuid())
  taskId     String
  userId     String
  userName   String?
  userAvatar String?
  content    String
  mentions   String?  // JSON array: '["usr-carlos", "team-financeiro"]'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

model TaskDependency {
  id              String   @id @default(uuid())
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  task            Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task     @relation("TaskDependentOnMe", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
}

model TaskHistory {
  id        String   @id @default(uuid())
  taskId    String
  userId    String?
  userName  String?
  action    String   // CREATED, ASSIGNED, CLAIMED, STARTED, WAITING, RESUMED, CHECKLIST_ITEM_COMPLETED, COMMENT_ADDED, DOCUMENT_LINKED, REASSIGNED, ESCALATED, COMPLETED, REOPENED, CANCELLED
  details   String?  // JSON string
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
}

model Team {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique // FINANCEIRO, SAC, ESTORNO, SUPORTE_EVENTOS, CONTABILIDADE, MARKETING, OPERACOES, SEGURANCA
  description    String?
  leaderUserId   String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members        TeamMember[]
  dutySchedules  DutySchedule[]

  @@index([code])
  @@index([isActive])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      String   @default("ANALYST") // LEADER, SUPERVISOR, ANALYST, MEMBER
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Workflow {
  id             String            @id @default(uuid())
  name           String
  description    String?
  module         String            // FINANCEIRO, SAC, EVENTOS, ESTORNO, CONTABILIDADE, MARKETING, SEGURANCA
  triggerEvent   String            // RECONCILIATION_DIVERGENCE_DETECTED, REFUND_REQUESTED, TICKET_CREATED, etc.
  isActive       Boolean           @default(true)
  currentVersion Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  versions       WorkflowVersion[]
  rules          WorkflowRule[]

  @@index([module])
  @@index([triggerEvent])
  @@index([isActive])
}

model WorkflowVersion {
  id              String   @id @default(uuid())
  workflowId      String
  version         Int
  rulesSnapshot   String   // JSON array of rules
  changeReason    String?
  createdByUserId String
  createdAt       DateTime @default(now())

  workflow        Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([workflowId])
}

model WorkflowRule {
  id            String           @id @default(uuid())
  workflowId    String
  version       Int              @default(1)
  name          String?
  conditionJson String           // JSON rules
  actionJson    String           // JSON action specs
  priority      String           @default("NORMAL")
  slaMinutes    Int              @default(120)
  targetTeamId  String?
  orderIndex    Int              @default(0)

  workflow      Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  actions       WorkflowAction[]

  @@index([workflowId])
}

model WorkflowAction {
  id             String       @id @default(uuid())
  workflowRuleId String
  actionType     String       // CREATE_TASK, NOTIFY, ROUTE_TEAM, FORWARD_APPROVAL
  payload        String       // JSON payload

  rule           WorkflowRule @relation(fields: [workflowRuleId], references: [id], onDelete: Cascade)

  @@index([workflowRuleId])
}

model TaskTemplate {
  id                      String   @id @default(uuid())
  code                    String   @unique
  title                   String
  description             String?
  module                  String
  priority                String   @default("NORMAL")
  defaultEstimatedMinutes Int      @default(120)
  targetTeamCode          String?
  checklistTemplate       String?  // JSON array of items: '[{"text": "Conferir pedido", "isRequired": true}]'
  createdAt               DateTime @default(now())

  @@index([code])
  @@index([module])
}

model SlaPolicy {
  id                      String   @id @default(uuid())
  name                    String
  module                  String
  priority                String   @default("NORMAL")
  durationMinutes         Int      @default(120)
  warningThresholdPercent Int      @default(80)
  criticalThresholdPercent Int     @default(95)
  allowPause              Boolean  @default(true)
  allowedPauseReasons     String   // JSON array: '["CLIENTE", "PRODUTOR", "FORNECEDOR", "BANCO", "GATEWAY", "OUTRO_DEPARTAMENTO"]'
  createdAt               DateTime @default(now())

  escalationRules         EscalationRule[]

  @@index([module, priority])
}

model SlaEvent {
  id        String   @id @default(uuid())
  taskId    String
